---

---

<div
    id="modalOverlay"
    class="font-space fixed hidden inset-0 bg-black/70 backdrop-blur-md z-50 items-center justify-center px-6 py-10"
>
    <div
        class="w-full max-w-6xl min-h-200 bg-[#17141F] border border-[#2A2633] rounded-3xl overflow-hidden grid md:grid-cols-2 relative shadow-2xl"
    >
        <button
            id="closeModal"
            class="absolute top-5 right-5 text-[#A1A1AA] hover:text-[#C4B5FD] transition-colors z-50"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>

        <div class="relative overflow-hidden">
            <div class="absolute inset-0 bg-[#09090B]/70"></div>

            <div
                class="absolute inset-0 bg-linear-to-br from-[#A78BFA]/20 via-transparent to-transparent"
            >
            </div>

            <img class="absolute w-full h-200 object-cover opacity-15" src="logoxdg.webp" alt="XDG Logo">

            <div
                class="relative z-10 flex flex-col justify-between h-full p-14"
            >
                <div>
                    <h1 class="text-4xl font-bold text-white tracking-tight">
                        XDG<span class="text-[#A78BFA]"> — </span>
                    </h1>
                </div>

                <div>
                    <h2
                        class="text-6xl leading-[0.95] font-bold uppercase text-white"
                    >
                        Entra a <br>
                        <span class="text-[#C4B5FD]">XDG.</span>
                    </h2>

                    <p
                        class="mt-8 text-[#D4D4D8] text-lg max-w-md leading-relaxed"
                    >
                        Acceda a su biblioteca definitiva y únase a la comunidad
                        de élite de exploradores digitales.
                    </p>
                </div>
            </div>
        </div>

        <div class="bg-[#1D1A23] p-14 flex flex-col justify-between">
            <div>
                <div
                    class="bg-[#211E27] border border-[#2A2633] rounded-2xl p-2 flex mb-16"
                >
                    <button
                        id="loginTab"
                        class="flex-1 bg-[#A78BFA] text-black py-4 rounded-lg text-xs font-bold tracking-widest uppercase transition-all shadow-lg shadow-[#A78BFA]/50"
                    >
                        Login
                    </button>

                    <button
                        id="registerTab"
                        class="flex-1 text-[#A1A1AA] py-4 rounded-lg text-xs font-bold tracking-widest uppercase transition-all shadow-lg"
                    >
                        Register
                    </button>
                </div>

                <div id="text" class="pb-6">
                    <span class="text-[#E7E0ED] font-bold text-2xl"
                        >Bienvenido Denuevo</span
                    >
                    <p class="text-[#CBC3D7]">
                        Continúa tu viaje donde lo dejaste.
                    </p>
                </div>

                <form id="loginForm" class="space-y-8" novalidate>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454]"
                        >
                            Identificacion de Usuario
                        </label>

                        <input
                            id="loginIdentifier"
                            type="text"
                            placeholder="Tu usuario o correo electrónico"
                            class="mt-3 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors"
                        />
                        <p id="loginIdentifier-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>

                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454]"
                        >
                            Contraseña
                        </label>

                        <div class="relative mt-3">
                            <input
                                id="loginPassword"
                                type="password"
                                placeholder="••••••••"
                                class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors pr-14"
                            />
                            <button type="button" id="toggleLoginPassword" class="absolute right-5 top-1/2 -translate-y-1/2 text-[#6B7280] hover:text-[#A78BFA] transition-colors">
                                <svg id="eyeLoginOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg id="eyeLoginClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        <p id="loginPassword-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>

                    <div class="flex justify-between items-center">
                        <label
                            class="flex items-center gap-3 text-sm text-[#494454]"
                        >
                            <input
                                type="checkbox"
                                class="appearance-none w-4 h-4 rounded-md border border-[#494454] bg-transparent checked:bg-[#A78BFA] checked:border-[#A78BFA] transition-all cursor-pointer"
                            />
                            Guardar sesión
                        </label>

                        <button
                            type="button"
                            class="text-[#A78BFA] text-sm hover:text-white transition-colors"
                        >
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>

                    <button
                        id="loginSubmit"
                        type="submit"
                        class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] transition-all text-black font-bold py-5 rounded-2xl uppercase tracking-[0.2em]"
                    >
                        Iniciar Sesión
                    </button>
                </form>

                <!-- Register Form -->

                <div id="text2" class="pb-6 hidden">
                    <span class="text-[#E7E0ED] font-bold text-2xl"
                        >Registrate</span
                    >
                    <p class="text-[#CBC3D7]">Se un nuevo usuario de XDG.</p>
                </div>

                <form id="registerForm" class="space-y-6 hidden" novalidate>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Nombre Personal
                        </label>
                        <input
                            id="regName"
                            type="text"
                            placeholder="Nombre Personal"
                            class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors"
                        />
                        <p id="regName-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Usuario
                        </label>
                        <input
                            id="regUsername"
                            type="text"
                            placeholder="Nombre de usuario"
                            class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors"
                        />
                        <p id="regUsername-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Correo Electrónico</label
                        >
                        <input
                            id="regEmail"
                            type="email"
                            placeholder="Correo electrónico"
                            class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors"
                        />
                        <p id="regEmail-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Contraseña</label
                        >
                        <div class="relative mt-2">
                            <input
                                id="regPassword"
                                type="password"
                                placeholder="Mínimo 8 caracteres"
                                class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors pr-14"
                            />
                            <button type="button" id="toggleRegPassword" class="absolute right-5 top-1/2 -translate-y-1/2 text-[#6B7280] hover:text-[#A78BFA] transition-colors">
                                <svg id="eyeRegOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg id="eyeRegClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        <!-- Barra de fortaleza de contraseña -->
                        <div class="mt-3 space-y-1">
                            <div class="flex gap-1">
                                <div id="strength-bar-1" class="h-1 flex-1 rounded-full bg-[#2A2633] transition-all"></div>
                                <div id="strength-bar-2" class="h-1 flex-1 rounded-full bg-[#2A2633] transition-all"></div>
                                <div id="strength-bar-3" class="h-1 flex-1 rounded-full bg-[#2A2633] transition-all"></div>
                                <div id="strength-bar-4" class="h-1 flex-1 rounded-full bg-[#2A2633] transition-all"></div>
                            </div>
                            <p id="strength-text" class="text-xs text-[#494454]"></p>
                        </div>
                        <p id="regPassword-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Confirmar Contraseña</label
                        >
                        <div class="relative mt-2">
                            <input
                                id="regConfirmPassword"
                                type="password"
                                placeholder="Repite tu contraseña"
                                class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors pr-14"
                            />
                            <button type="button" id="toggleRegConfirm" class="absolute right-5 top-1/2 -translate-y-1/2 text-[#6B7280] hover:text-[#A78BFA] transition-colors">
                                <svg id="eyeConfirmOpen" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg id="eyeConfirmClosed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        <p id="regConfirmPassword-error" class="hidden mt-2 text-xs text-red-400 pl-1"></p>
                    </div>
                    <button
                        id="registerSubmit"
                        type="submit"
                        class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] transition-all text-black font-bold py-5 rounded-2xl uppercase tracking-[0.2em]"
                    >
                        Crear Cuenta
                    </button>
                </form>
            </div>

            <div
                class="pt-10 text-center text-xs uppercase tracking-widest text-[#52525B]"
            >
                Protegido por el cifrado XDG-Shield
            </div>
        </div>
    </div>
</div>

<script>
    // ─── Utilidades ───────────────────────────────────────────────────────────
    function showError(id: string, msg: string) {
        const el = document.getElementById(id + "-error");
        const input = document.getElementById(id) as HTMLInputElement | null;
        if (el) { el.textContent = msg; el.classList.remove("hidden"); }
        if (input) input.classList.add("border-red-500/70");
    }

    function clearError(id: string) {
        const el = document.getElementById(id + "-error");
        const input = document.getElementById(id) as HTMLInputElement | null;
        if (el) { el.textContent = ""; el.classList.add("hidden"); }
        if (input) input.classList.remove("border-red-500/70");
    }

    function validateEmail(email: string) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    // ─── Toggle mostrar/ocultar contraseña ────────────────────────────────────
    function setupPasswordToggle(btnId: string, inputId: string, eyeOpenId: string, eyeClosedId: string) {
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId) as HTMLInputElement | null;
        const eyeOpen = document.getElementById(eyeOpenId);
        const eyeClosed = document.getElementById(eyeClosedId);
        btn?.addEventListener("click", () => {
            if (!input) return;
            const isPassword = input.type === "password";
            input.type = isPassword ? "text" : "password";
            eyeOpen?.classList.toggle("hidden", isPassword);
            eyeClosed?.classList.toggle("hidden", !isPassword);
        });
    }
    setupPasswordToggle("toggleLoginPassword", "loginPassword", "eyeLoginOpen", "eyeLoginClosed");
    setupPasswordToggle("toggleRegPassword",   "regPassword",   "eyeRegOpen",   "eyeRegClosed");
    setupPasswordToggle("toggleRegConfirm",    "regConfirmPassword", "eyeConfirmOpen", "eyeConfirmClosed");

    // ─── Fortaleza de contraseña ──────────────────────────────────────────────
    const strengthColors = ["bg-red-500", "bg-orange-400", "bg-yellow-400", "bg-green-400"];
    const strengthLabels = ["Muy débil", "Débil", "Buena", "Fuerte"];

    function checkStrength(password: string): number {
        let score = 0;
        if (password.length >= 8)  score++;
        if (/[A-Z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^A-Za-z0-9]/.test(password)) score++;
        return score;
    }

    document.getElementById("regPassword")?.addEventListener("input", (e) => {
        const val = (e.target as HTMLInputElement).value;
        const score = val ? checkStrength(val) : 0;
        for (let i = 1; i <= 4; i++) {
            const bar = document.getElementById("strength-bar-" + i);
            if (!bar) continue;
            bar.className = "h-1 flex-1 rounded-full transition-all " +
                (i <= score ? strengthColors[score - 1] : "bg-[#2A2633]");
        }
        const txt = document.getElementById("strength-text");
        if (txt) txt.textContent = val ? strengthLabels[score - 1] ?? "" : "";
        if (val) clearError("regPassword");
    });

    // ─── Limpiar error al escribir ────────────────────────────────────────────
    ["loginIdentifier", "loginPassword"].forEach(id => {
        document.getElementById(id)?.addEventListener("input", () => clearError(id));
    });
    ["regName", "regUsername", "regEmail", "regPassword", "regConfirmPassword"].forEach(id => {
        document.getElementById(id)?.addEventListener("input", () => clearError(id));
    });

    // ─── Validación Login ─────────────────────────────────────────────────────
    document.getElementById("loginForm")?.addEventListener("submit", (e) => {
        e.preventDefault();
        let valid = true;

        const identifier = (document.getElementById("loginIdentifier") as HTMLInputElement)?.value.trim();
        const password   = (document.getElementById("loginPassword")   as HTMLInputElement)?.value;

        clearError("loginIdentifier");
        clearError("loginPassword");

        if (!identifier) {
            showError("loginIdentifier", "Ingresa tu usuario o correo electrónico.");
            valid = false;
        }

        if (!password) {
            showError("loginPassword", "Ingresa tu contraseña.");
            valid = false;
        } else if (password.length < 6) {
            showError("loginPassword", "La contraseña debe tener al menos 6 caracteres.");
            valid = false;
        }

        if (valid) {
            // Aquí va tu lógica de login / fetch al backend
            console.log("Login válido:", { identifier, password });
        }
    });

    // ─── Validación Register ──────────────────────────────────────────────────
    document.getElementById("registerForm")?.addEventListener("submit", (e) => {
        e.preventDefault();
        let valid = true;

        const name    = (document.getElementById("regName")            as HTMLInputElement)?.value.trim();
        const username= (document.getElementById("regUsername")        as HTMLInputElement)?.value.trim();
        const email   = (document.getElementById("regEmail")           as HTMLInputElement)?.value.trim();
        const password= (document.getElementById("regPassword")        as HTMLInputElement)?.value;
        const confirm = (document.getElementById("regConfirmPassword") as HTMLInputElement)?.value;

        ["regName","regUsername","regEmail","regPassword","regConfirmPassword"].forEach(clearError);

        if (!name || name.length < 2) {
            showError("regName", "Ingresa tu nombre completo (mínimo 2 caracteres).");
            valid = false;
        }

        if (!username || username.length < 3) {
            showError("regUsername", "El usuario debe tener al menos 3 caracteres.");
            valid = false;
        } else if (/\s/.test(username)) {
            showError("regUsername", "El usuario no puede contener espacios.");
            valid = false;
        }

        if (!email) {
            showError("regEmail", "Ingresa tu correo electrónico.");
            valid = false;
        } else if (!validateEmail(email)) {
            showError("regEmail", "Ingresa un correo electrónico válido.");
            valid = false;
        }

        if (!password) {
            showError("regPassword", "Ingresa una contraseña.");
            valid = false;
        } else if (password.length < 8) {
            showError("regPassword", "La contraseña debe tener al menos 8 caracteres.");
            valid = false;
        } else if (checkStrength(password) < 2) {
            showError("regPassword", "La contraseña es muy débil. Agrega mayúsculas, números o símbolos.");
            valid = false;
        }

        if (!confirm) {
            showError("regConfirmPassword", "Confirma tu contraseña.");
            valid = false;
        } else if (confirm !== password) {
            showError("regConfirmPassword", "Las contraseñas no coinciden.");
            valid = false;
        }

        if (valid) {
            // Aquí va tu lógica de registro / fetch al backend
            console.log("Registro válido:", { name, username, email });
        }
    });

    // ─── Tabs ─────────────────────────────────────────────────────────────────
    const overlay      = document.getElementById("modalOverlay");
    const closeBtn     = document.getElementById("closeModal");
    const text         = document.getElementById("text");
    const text2        = document.getElementById("text2");
    const loginTab     = document.getElementById("loginTab");
    const registerTab  = document.getElementById("registerTab");
    const loginForm    = document.getElementById("loginForm");
    const registerForm = document.getElementById("registerForm");

    window.addEventListener("open-login-modal", () => {
        overlay?.classList.remove("hidden");
        overlay?.classList.add("flex");
    });

    closeBtn?.addEventListener("click", () => {
        overlay?.classList.add("hidden");
        overlay?.classList.remove("flex");
    });

    overlay?.addEventListener("click", (e) => {
        if (e.target === overlay) {
            overlay?.classList.add("hidden");
            overlay?.classList.remove("flex");
        }
    });

    loginTab?.addEventListener("click", () => {
        loginForm?.classList.remove("hidden");
        registerForm?.classList.add("hidden");
        text?.classList.remove("hidden");
        text2?.classList.add("hidden");

        loginTab?.classList.add("bg-[#A78BFA]", "text-black", "shadow-lg", "shadow-[#A78BFA]/40");
        loginTab?.classList.remove("text-[#A1A1AA]");
        registerTab?.classList.remove("bg-[#A78BFA]", "text-black", "shadow-lg", "shadow-[#A78BFA]/40");
        registerTab?.classList.add("text-[#A1A1AA]");
    });

    registerTab?.addEventListener("click", () => {
        registerForm?.classList.remove("hidden");
        loginForm?.classList.add("hidden");
        text?.classList.add("hidden");
        text2?.classList.remove("hidden");

        registerTab?.classList.add("bg-[#A78BFA]", "text-black", "shadow-lg", "shadow-[#A78BFA]/40");
        registerTab?.classList.remove("text-[#A1A1AA]");
        loginTab?.classList.remove("bg-[#A78BFA]", "text-black", "shadow-lg", "shadow-[#A78BFA]/40");
        loginTab?.classList.add("text-[#A1A1AA]");
    });
</script>