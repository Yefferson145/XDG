---

---

<div
    id="modalOverlay"
    class="font-space fixed hidden inset-0 bg-black/70 backdrop-blur-md z-50 items-center justify-center px-6 py-10"
>
    <div
        class="w-full max-w-6xl min-h-200 bg-[#17141F] border border-[#2A2633] rounded-3xl overflow-hidden grid md:grid-cols-2 relative shadow-2xl"
    >
        <button
            id="closeModal"
            class="absolute top-5 right-5 text-[#A1A1AA] hover:text-[#C4B5FD] transition-colors z-50"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>

        <div class="relative overflow-hidden">
            <div class="absolute inset-0 bg-[#09090B]/70"></div>

            <div
                class="absolute inset-0 bg-linear-to-br from-[#A78BFA]/20 via-transparent to-transparent"
            >
            </div>

            <img class="absolute w-full h-200 object-cover opacity-15" src="logoxdg.webp" alt="XDG Logo">

            <div
                class="relative z-10 flex flex-col justify-between h-full p-14"
            >
                <div>
                    <h1 class="text-4xl font-bold text-white tracking-tight">
                        XDG<span class="text-[#A78BFA]"> — </span>
                    </h1>
                </div>

                <div>
                    <h2
                        class="text-6xl leading-[0.95] font-bold uppercase text-white"
                    >
                        Entra a <br>
                        <span class="text-[#C4B5FD]">XDG.</span>
                    </h2>

                    <p
                        class="mt-8 text-[#D4D4D8] text-lg max-w-md leading-relaxed"
                    >
                        Acceda a su biblioteca definitiva y únase a la comunidad
                        de élite de exploradores digitales.
                    </p>
                </div>
            </div>
        </div>

        <div class="bg-[#1D1A23] p-14 flex flex-col justify-between">
            <div>
                <div
                    class="bg-[#211E27] border border-[#2A2633] rounded-2xl p-2 flex mb-16"
                >
                    <button
                        id="loginTab"
                        class="flex-1 bg-[#A78BFA] text-black py-4 rounded-lg text-xs font-bold tracking-widest uppercase transition-all shadow-lg shadow-[#A78BFA]/50"
                    >
                        Login
                    </button>

                    <button
                        id="registerTab"
                        class="flex-1 text-[#A1A1AA] py-4 rounded-lg text-xs font-bold tracking-widest uppercase transition-all shadow-lg"
                    >
                        Register
                    </button>
                </div>

                <div id="text" class="pb-6">
                    <span class="text-[#E7E0ED] font-bold text-2xl"
                        >Bienvenido Denuevo</span
                    >
                    <p class="text-[#CBC3D7]">
                        Continúa tu viaje donde lo dejaste.
                    </p>
                </div>

                <form id="loginForm" class="space-y-8">
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454]"
                        >
                            Identificacion de Usuario
                        </label>

                        <input
                            type="text"
                            placeholder="Tu usuario o correo electrónico"
                            class="mt-3 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA]"
                        />
                    </div>

                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454]"
                        >
                            Contraseña
                        </label>

                        <input
                            type="password"
                            placeholder="••••••••"
                            class="mt-3 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA]"
                        />
                    </div>

                    <div class="flex justify-between items-center">
                        <label
                            class="flex items-center gap-3 text-sm text-[#494454]"
                        >
                            <input
                                type="checkbox"
                                class="appearance-none w-4 h-4 rounded-md border border-[#494454] bg-transparent checked:bg-[#A78BFA] checked:border-[#A78BFA] transition-all cursor-pointer"
                            />
                            Guardar sesión
                        </label>

                        <button
                            type="button"
                            class="text-[#A78BFA] text-sm hover:text-white transition-colors"
                        >
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>

                    <button
                        class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] transition-all text-black font-bold py-5 rounded-2xl uppercase tracking-[0.2em]"
                    >
                        Iniciar Sesión
                    </button>
                </form>

                <!-- Register Form -->

                <div id="text2" class="pb-6">
                    <span class="text-[#E7E0ED] font-bold text-2xl"
                        >Registrate</span
                    >
                    <p class="text-[#CBC3D7]">Se un nuevo usuario de XDG.</p>
                </div>

                <form id="registerForm" class="space-y-6 hidden">
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Nombre Personal
                        </label>
                        <input
                            type="text"
                            placeholder="Nombre Personal"
                            class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white"
                        />
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Usuario
                        </label>
                        <input
                            type="text"
                            placeholder="Nombre de usuario"
                            class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white"
                        />
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Correo Electrónico</label
                        >
                        <input
                            type="email"
                            placeholder="Correo electrónico"
                            class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white"
                        />
                    </div>
                    <div>
                        <label
                            class="text-xs uppercase tracking-[0.25em] text-[#494454] py-1"
                            >Contraseña</label
                        >
                        <input
                            type="password"
                            placeholder="Contraseña"
                            class="w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-6 py-5 text-white"
                        />
                    </div>
                    <button
                        class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] transition-all text-black font-bold py-5 rounded-2xl uppercase tracking-[0.2em]"
                    >
                        Crear Cuenta
                    </button>
                </form>
            </div>

            <div
                class="pt-10 text-center text-xs uppercase tracking-widest text-[#52525B]"
            >
                Protegido por el cifrado XDG-Shield
            </div>
        </div>
    </div>
</div>

<script>
    
    const overlay = document.getElementById("modalOverlay") || null;
    const closeBtn = document.getElementById("closeModal") || null;
    const text = document.getElementById("text") || null;
    const text2 = document.getElementById("text2") || null;

    const loginTab = document.getElementById("loginTab") || null;
    const registerTab = document.getElementById("registerTab") || null;

    const loginForm = document.getElementById("loginForm") || null;
    const registerForm = document.getElementById("registerForm") || null;

    window.addEventListener("open-login-modal", () => {
        overlay?.classList.remove("hidden");
        overlay?.classList.add("flex");
    });

    closeBtn?.addEventListener("click", () => {
        overlay?.classList.add("hidden");
        overlay?.classList.remove("flex");
    });

    overlay?.addEventListener("click", (e) => {
        if (e.target === overlay) {
            overlay?.classList.add("hidden");
            overlay?.classList.remove("flex");
        }
    });

    loginTab?.addEventListener("click", () => {
        loginForm?.classList.remove("hidden");
        registerForm?.classList.add("hidden");
        text?.classList.remove("hidden");
        text2?.classList.add("hidden");

        loginTab?.classList.add(
            "bg-[#A78BFA]",
            "text-black",
            "shadow-lg",
            "shadow-[#A78BFA]/40",
        );

        loginTab?.classList.remove("text-[#A1A1AA]");

        registerTab?.classList.remove(
            "bg-[#A78BFA]",
            "text-black",
            "shadow-lg",
            "shadow-[#A78BFA]/40",
        );

        registerTab?.classList.add("text-[#A1A1AA]");
    });

    registerTab?.addEventListener("click", () => {
        registerForm?.classList.remove("hidden");
        loginForm?.classList.add("hidden");
        text?.classList.add("hidden");
        text2?.classList.remove("hidden");

        registerTab?.classList.add(
            "bg-[#A78BFA]",
            "text-black",
            "shadow-lg",
            "shadow-[#A78BFA]/40",
        );

        registerTab?.classList.remove("text-[#A1A1AA]");

        loginTab?.classList.remove(
            "bg-[#A78BFA]",
            "text-black",
            "shadow-lg",
            "shadow-[#A78BFA]/40",
        );

        loginTab?.classList.add("text-[#A1A1AA]");
    });
</script>
