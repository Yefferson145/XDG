---
interface Props {
  title: string;
  description: string;
  price: number;
  originalPrice?: number;
  discount?: number;
  imageUrl: string;
  id: number;
}

const { title, description, price, originalPrice, discount, imageUrl, id } = Astro.props;
const hasDiscount = discount != null && discount > 0;
---

<a href={`/detail/${id}`} class="flex flex-col bg-[#1A1A1D] rounded-xl overflow-hidden border border-[#27272A] hover:border-[#A78BFA] transition-all duration-300 group cursor-pointer">

    <figure class="relative aspect-3/4 overflow-hidden">
        {hasDiscount && (
            <span class="absolute top-2 left-2 z-10 bg-[#A78BFA] text-[#09090B] text-xs font-bold px-2 py-0.5 rounded-md">
                -{discount}%
            </span>
        )}
        <img
            src={imageUrl}
            alt={`Portada de ${title}`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
    </figure>

    <div class="p-4 flex flex-col grow justify-between">
        <div>
            <h3 class="text-white font-bold text-lg truncate">{title}</h3>
            <p class="text-[#71717A] text-xs mt-1 line-clamp-2">{description}</p>
        </div>

        <div class="mt-4 flex justify-between items-center">
            <div class="flex flex-col">
                {hasDiscount && (
                    <span class="text-[#71717A] text-xs line-through">${originalPrice?.toFixed(2)}</span>
                )}
                <span class={`font-semibold ${hasDiscount ? "text-[#A78BFA]" : "text-white"}`}>
                    ${price.toFixed(2)}
                </span>
            </div>
            <button class="bg-[#27272A] text-white p-2 rounded-full hover:bg-[#A78BFA] hover:text-[#09090B] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </button>
        </div>
    </div>
</a>