
<div
  id="profileOverlay"
  class="font-space fixed hidden inset-0 bg-black/70 backdrop-blur-md z-[60] items-center justify-center px-4 py-8"
>
  <div class="w-full max-w-5xl bg-[#17141F] border border-[#2A2633] rounded-3xl overflow-hidden grid md:grid-cols-[260px_1fr] relative shadow-2xl max-h-[90vh]">
 
    <button id="closeProfile" class="absolute top-5 right-5 text-[#A1A1AA] hover:text-white transition-colors z-50">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
 
    <!-- Sidebar izquierda -->
    <div class="relative overflow-hidden bg-[#13101A] border-r border-[#2A2633] flex flex-col">
      <div class="relative p-8 pb-6">
        <img src="/XDG.jpg" alt="XDG" class="absolute inset-0 w-full h-full object-cover opacity-20" />
        <div class="relative z-10">
          <h1 class="text-2xl font-bold text-white tracking-tight mb-6">XDG<span class="text-[#A78BFA]"> — </span></h1>
          <div class="w-16 h-16 rounded-2xl bg-[#A78BFA]/20 border-2 border-[#A78BFA]/40 flex items-center justify-center mb-3">
            <span id="profileAvatarLetter" class="text-[#A78BFA] font-bold text-3xl uppercase">?</span>
          </div>
          <p id="profileDisplayName" class="text-white font-bold text-lg">—</p>
          <p id="profileDisplayEmail" class="text-[#71717A] text-xs mt-0.5">—</p>
        </div>
      </div>
 
      <!-- Nav tabs vertical -->
      <nav class="flex flex-col px-3 pb-6 gap-1">
        {[
          { id: "info",    icon: "M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z", label: "Mi Perfil" },
          { id: "password", icon: "M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm0 10.9h6c-.5 2.8-2.8 5.1-6 5.7V12H6V7.3L12 4.5V11.9z", label: "Contraseña" },
          { id: "purchases", icon: "M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0", label: "Mis Compras" },
          { id: "games",  icon: "M2.535 14Q1.26 14 .56 13.113q-.7-.888-.525-2.163l1.05-7.5Q1.31 1.95 2.423.975A3.84 3.84 0 0 1 5.034 0h9.9q1.5 0 2.612.975t1.338 2.475l1.05 7.5q.176 1.274-.525 2.163-.7.887-1.975.887a2.5 2.5 0 0 1-.975-.187 2.6 2.6 0 0 1-.825-.563L13.385 11h-6.8l-2.25 2.25q-.375.375-.825.563a2.5 2.5 0 0 1-.975.187", label: "Mis Juegos" },
          { id: "wishlist", icon: "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z", label: "Wishlist" },
        ].map((tab) => (
          <button
            data-tab={tab.id}
            class="profile-tab-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-left text-sm text-[#71717A] hover:text-white hover:bg-[#2A2633] transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={tab.icon}/></svg>
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
 
    <!-- Panel derecho -->
    <div class="flex flex-col overflow-y-auto max-h-[90vh]">
      <div class="p-8 flex-1">
 
        <div id="profileMessage" class="hidden mb-4 px-4 py-3 rounded-xl text-sm font-medium"></div>
 
        <!-- ── PANEL: INFO ── -->
        <div id="panel-info" class="profile-panel">
          <h2 class="text-white font-bold text-2xl mb-1">Información Personal</h2>
          <p class="text-[#71717A] text-sm mb-6">Actualiza tu nombre, usuario y correo.</p>
          <div class="space-y-4">
            <div>
              <label class="text-xs uppercase tracking-[0.2em] text-[#494454]">Nombre</label>
              <input id="profileNombre" type="text" class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-5 py-4 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors" />
              <p id="profileNombre-error" class="hidden mt-1 text-xs text-red-400 pl-1"></p>
            </div>
            <div>
              <label class="text-xs uppercase tracking-[0.2em] text-[#494454]">Usuario</label>
              <input id="profileUsuario" type="text" class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-5 py-4 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors" />
              <p id="profileUsuario-error" class="hidden mt-1 text-xs text-red-400 pl-1"></p>
            </div>
            <div>
              <label class="text-xs uppercase tracking-[0.2em] text-[#494454]">Correo Electrónico</label>
              <input id="profileCorreo" type="email" class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-5 py-4 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors" />
              <p id="profileCorreo-error" class="hidden mt-1 text-xs text-red-400 pl-1"></p>
            </div>
            <button id="saveInfoBtn" class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] text-black font-bold py-4 rounded-2xl uppercase tracking-[0.2em] flex items-center justify-center gap-2 transition-all">
              <span id="saveInfoText">Guardar Cambios</span>
              <svg id="saveInfoSpinner" class="hidden animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
            </button>
          </div>
        </div>
 
        <!-- ── PANEL: PASSWORD ── -->
        <div id="panel-password" class="profile-panel hidden">
          <h2 class="text-white font-bold text-2xl mb-1">Cambiar Contraseña</h2>
          <p class="text-[#71717A] text-sm mb-6">Elige una contraseña segura.</p>
          <div class="space-y-4">
            {[
              { id: "currentPwd", label: "Contraseña Actual", ph: "••••••••" },
              { id: "newPwd", label: "Nueva Contraseña", ph: "Mínimo 6 caracteres" },
              { id: "confirmPwd", label: "Confirmar Nueva Contraseña", ph: "Repite la nueva contraseña" },
            ].map((f) => (
              <div>
                <label class="text-xs uppercase tracking-[0.2em] text-[#494454]">{f.label}</label>
                <input id={f.id} type="password" placeholder={f.ph} class="mt-2 w-full bg-[#15121B] border border-[#2A2633] rounded-2xl px-5 py-4 text-white placeholder:text-[#6B7280] focus:outline-none focus:border-[#A78BFA] transition-colors" />
                <p id={`${f.id}-error`} class="hidden mt-1 text-xs text-red-400 pl-1"></p>
              </div>
            ))}
            <button id="savePwdBtn" class="w-full bg-[#A78BFA] hover:bg-[#8B5CF6] text-black font-bold py-4 rounded-2xl uppercase tracking-[0.2em] flex items-center justify-center gap-2 transition-all">
              <span id="savePwdText">Cambiar Contraseña</span>
              <svg id="savePwdSpinner" class="hidden animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
            </button>
          </div>
        </div>
 
        <!-- ── PANEL: COMPRAS ── -->
        <div id="panel-purchases" class="profile-panel hidden">
          <h2 class="text-white font-bold text-2xl mb-1">Mis Compras</h2>
          <p class="text-[#71717A] text-sm mb-6">Historial completo de tus transacciones.</p>
          <div id="purchasesList" class="space-y-3">
            <p class="text-[#71717A] text-sm text-center py-8">Cargando...</p>
          </div>
        </div>
 
        <!-- ── PANEL: JUEGOS ── -->
        <div id="panel-games" class="profile-panel hidden">
          <h2 class="text-white font-bold text-2xl mb-1">Mis Juegos</h2>
          <p class="text-[#71717A] text-sm mb-6">Todos los juegos que has adquirido.</p>
          <div id="gamesList" class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <p class="text-[#71717A] text-sm col-span-3 text-center py-8">Cargando...</p>
          </div>
        </div>
 
        <!-- ── PANEL: WISHLIST ── -->
        <div id="panel-wishlist" class="profile-panel hidden">
          <h2 class="text-white font-bold text-2xl mb-1">Lista de Deseos</h2>
          <p class="text-[#71717A] text-sm mb-6">Los juegos que quieres conseguir.</p>
          <div id="wishlistList" class="space-y-3">
            <p class="text-[#71717A] text-sm text-center py-8">Cargando...</p>
          </div>
        </div>
 
      </div>
    </div>
  </div>
</div>
 
<style>
  .profile-tab-btn.active {
    background: #2A2633;
    color: #A78BFA;
  }
</style>
 
<script>
  const API = "http://localhost:8080";
  const overlay = document.getElementById("profileOverlay")!;
  const tabs = document.querySelectorAll<HTMLButtonElement>(".profile-tab-btn");
 
  /* ── helpers ── */
  function showMsg(text: string, ok = true) {
    const el = document.getElementById("profileMessage")!;
    el.textContent = text;
    el.className = `mb-4 px-4 py-3 rounded-xl text-sm font-medium ${ok
      ? "bg-[#A78BFA]/10 text-[#A78BFA] border border-[#A78BFA]/30"
      : "bg-red-500/10 text-red-400 border border-red-500/30"}`;
    el.classList.remove("hidden");
    setTimeout(() => el.classList.add("hidden"), 4000);
  }
  function showErr(id: string, msg: string) {
    const el = document.getElementById(id + "-error");
    const inp = document.getElementById(id) as HTMLInputElement | null;
    if (el) { el.textContent = msg; el.classList.remove("hidden"); }
    if (inp) inp.classList.add("border-red-500/70");
  }
  function clearErr(id: string) {
    const el = document.getElementById(id + "-error");
    const inp = document.getElementById(id) as HTMLInputElement | null;
    if (el) el.classList.add("hidden");
    if (inp) inp.classList.remove("border-red-500/70");
  }
 
  /* ── tab switching ── */
  function activateTab(tabId: string) {
    tabs.forEach(b => b.classList.toggle("active", b.dataset.tab === tabId));
    document.querySelectorAll(".profile-panel").forEach(p => p.classList.add("hidden"));
    document.getElementById(`panel-${tabId}`)?.classList.remove("hidden");
 
    if (tabId === "purchases") loadPurchases();
    if (tabId === "games")    loadGames();
    if (tabId === "wishlist") loadWishlist();
  }
 
  tabs.forEach(btn => btn.addEventListener("click", () => activateTab(btn.dataset.tab!)));
 
  /* ── open / close ── */
  window.addEventListener("open-profile-modal", async () => {
    overlay.classList.remove("hidden"); overlay.classList.add("flex");
    activateTab("info");
    try {
      const data = await fetch(`${API}/api/session.jsp`, { credentials: "include" }).then(r => r.json());
      if (data.logged) {
        document.getElementById("profileAvatarLetter")!.textContent = (data.name || "?")[0].toUpperCase();
        document.getElementById("profileDisplayName")!.textContent  = data.name || "—";
        document.getElementById("profileDisplayEmail")!.textContent = data.email || "—";
        (document.getElementById("profileNombre")  as HTMLInputElement).value = data.name     || "";
        (document.getElementById("profileUsuario") as HTMLInputElement).value = data.username || data.name || "";
        (document.getElementById("profileCorreo")  as HTMLInputElement).value = data.email    || "";
      }
    } catch {}
  });
 
  document.getElementById("closeProfile")!.addEventListener("click", close);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
  function close() { overlay.classList.add("hidden"); overlay.classList.remove("flex"); }
 
  /* ── guardar info ── */
  document.getElementById("saveInfoBtn")!.addEventListener("click", async () => {
    const nombre  = (document.getElementById("profileNombre")  as HTMLInputElement).value.trim();
    const usuario = (document.getElementById("profileUsuario") as HTMLInputElement).value.trim();
    const correo  = (document.getElementById("profileCorreo")  as HTMLInputElement).value.trim();
    ["profileNombre","profileUsuario","profileCorreo"].forEach(clearErr);
 
    let ok = true;
    if (nombre.length  < 2) { showErr("profileNombre",  "Mínimo 2 caracteres."); ok = false; }
    if (usuario.length < 3) { showErr("profileUsuario", "Mínimo 3 caracteres."); ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) { showErr("profileCorreo", "Correo inválido."); ok = false; }
    if (!ok) return;
 
    const btn = document.getElementById("saveInfoBtn")!;
    const txt = document.getElementById("saveInfoText")!;
    const sp  = document.getElementById("saveInfoSpinner")!;
    btn.setAttribute("disabled","true"); txt.textContent = "Guardando..."; sp.classList.remove("hidden");
    try {
      const res  = await fetch(`${API}/api/auth.jsp`, {
        method: "POST", headers: { "Content-Type": "application/json" }, credentials: "include",
        body: JSON.stringify({ action: "updateInfo", nombre, usuario, correo }),
      });
      const data = await res.json();
      if (data.success) {
        showMsg("¡Información actualizada!");
        document.getElementById("profileAvatarLetter")!.textContent = nombre[0].toUpperCase();
        document.getElementById("profileDisplayName")!.textContent  = nombre;
        window.dispatchEvent(new CustomEvent("profile-updated", { detail: { nombre } }));
      } else { showMsg(data.message || "Error al actualizar.", false); }
    } catch { showMsg("Error de conexión.", false); }
    finally { btn.removeAttribute("disabled"); txt.textContent = "Guardar Cambios"; sp.classList.add("hidden"); }
  });
 
  /* ── cambiar contraseña ── */
  document.getElementById("savePwdBtn")!.addEventListener("click", async () => {
    const current = (document.getElementById("currentPwd") as HTMLInputElement).value;
    const newP    = (document.getElementById("newPwd")     as HTMLInputElement).value;
    const confirm = (document.getElementById("confirmPwd") as HTMLInputElement).value;
    ["currentPwd","newPwd","confirmPwd"].forEach(clearErr);
 
    let ok = true;
    if (!current) { showErr("currentPwd", "Ingresa tu contraseña actual."); ok = false; }
    if (newP.length < 6) { showErr("newPwd", "Mínimo 6 caracteres."); ok = false; }
    if (newP !== confirm) { showErr("confirmPwd", "Las contraseñas no coinciden."); ok = false; }
    if (!ok) return;
 
    const btn = document.getElementById("savePwdBtn")!;
    const txt = document.getElementById("savePwdText")!;
    const sp  = document.getElementById("savePwdSpinner")!;
    btn.setAttribute("disabled","true"); txt.textContent = "Cambiando..."; sp.classList.remove("hidden");
    try {
      const res  = await fetch(`${API}/api/auth.jsp`, {
        method: "POST", headers: { "Content-Type": "application/json" }, credentials: "include",
        body: JSON.stringify({ action: "changePassword", currentPassword: current, newPassword: newP }),
      });
      const data = await res.json();
      if (data.success) {
        showMsg("¡Contraseña cambiada!");
        ["currentPwd","newPwd","confirmPwd"].forEach(id => (document.getElementById(id) as HTMLInputElement).value = "");
      } else { showMsg(data.message || "No se pudo cambiar.", false); }
    } catch { showMsg("Error de conexión.", false); }
    finally { btn.removeAttribute("disabled"); txt.textContent = "Cambiar Contraseña"; sp.classList.add("hidden"); }
  });
 
  /* ── cargar compras ── */
  async function loadPurchases() {
    const el = document.getElementById("purchasesList")!;
    el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Cargando...</p>`;
    try {
      const sess = await fetch(`${API}/api/session.jsp`, { credentials: "include" }).then(r => r.json());
      if (!sess.logged) { el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Inicia sesión para ver tus compras.</p>`; return; }
 
      const data: any[] = await fetch(`${API}/api/ventas.jsp?user_id=${sess.id}`, { credentials: "include" }).then(r => r.json());
 
      if (!data.length) { el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Aún no tienes compras.</p>`; return; }
 
      el.innerHTML = data.map(v => `
        <div class="flex items-center bg-[#13101A] border border-[#2A2633] rounded-xl px-4 py-3 gap-3">
          <img src="${v.imagen_url || 'https://placehold.co/48x64/1A1A1D/A78BFA?text=XDG'}"
               class="w-10 h-14 object-cover rounded-lg shrink-0" alt="${v.titulo}" />
          <div class="flex-1 min-w-0">
            <p class="text-white text-sm font-semibold truncate">${v.titulo}</p>
            <p class="text-[#71717A] text-xs mt-0.5">${v.fecha?.substring(0,10) || "—"}</p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-[#A78BFA] font-bold text-sm">S/ ${Number(v.precio).toFixed(2)}</p>
            <p class="text-[#71717A] text-xs">x${v.cantidad}</p>
          </div>
        </div>`).join("");
    } catch { el.innerHTML = `<p class="text-red-400 text-sm text-center py-8">Error al cargar compras.</p>`; }
  }
 
  /* ── cargar juegos comprados (únicos por venta) ── */
  async function loadGames() {
    const el = document.getElementById("gamesList")!;
    el.innerHTML = `<p class="text-[#71717A] text-sm col-span-3 text-center py-8">Cargando...</p>`;
    try {
      const sess = await fetch(`${API}/api/session.jsp`, { credentials: "include" }).then(r => r.json());
      if (!sess.logged) { el.innerHTML = `<p class="text-[#71717A] text-sm col-span-3 text-center py-8">Inicia sesión.</p>`; return; }
 
      const ventas: any[] = await fetch(`${API}/api/ventas.jsp?user_id=${sess.id}`, { credentials: "include" }).then(r => r.json());
 
      // Juegos únicos por id de juego (deduplicados)
      const seen = new Set<string>();
      const unique = ventas.filter(v => { const k = String(v.juego_id || v.titulo); if(seen.has(k)) return false; seen.add(k); return true; });
 
      if (!unique.length) { el.innerHTML = `<p class="text-[#71717A] text-sm col-span-3 text-center py-8">No tienes juegos aún.</p>`; return; }
 
      // Obtener detalle de juegos para imagen
      const allGames: any[] = await fetch(`${API}/api/juegos.jsp`, { credentials: "include" }).then(r => r.json());
      const gamesMap: Record<string,any> = {};
      allGames.forEach(g => gamesMap[String(g.id)] = g);
 
      el.innerHTML = unique.map(v => {
        const g = gamesMap[String(v.juego_id)] || {};
        const img = g.imagen_url || `https://placehold.co/200x280/1A1A1D/A78BFA?text=XDG`;
        return `
        <a href="/detail/${v.juego_id}" class="group flex flex-col rounded-xl overflow-hidden border border-[#2A2633] hover:border-[#A78BFA] transition-all">
          <div class="aspect-[3/4] overflow-hidden">
            <img src="${img}" alt="${v.titulo}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-[#13101A]">
            <p class="text-white text-xs font-semibold truncate">${v.titulo}</p>
            <span class="inline-block mt-1 text-[10px] bg-[#A78BFA]/15 text-[#A78BFA] px-2 py-0.5 rounded-full">Adquirido</span>
          </div>
        </a>`;
      }).join("");
    } catch { el.innerHTML = `<p class="text-red-400 text-sm col-span-3 text-center py-8">Error al cargar juegos.</p>`; }
  }
 
  /* ── cargar wishlist ── */
  async function loadWishlist() {
    const el = document.getElementById("wishlistList")!;
    el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Cargando...</p>`;
    try {
      const sess = await fetch(`${API}/api/session.jsp`, { credentials: "include" }).then(r => r.json());
      if (!sess.logged) { el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Inicia sesión.</p>`; return; }
 
      const items: any[] = await fetch(`${API}/api/wishlist.jsp?user_id=${sess.id}`, { credentials: "include" }).then(r => r.json());
 
      if (!items.length) { el.innerHTML = `<p class="text-[#71717A] text-sm text-center py-8">Tu lista de deseos está vacía.</p>`; return; }
 
      el.innerHTML = items.map(item => `
        <div class="flex items-center gap-3 bg-[#13101A] border border-[#2A2633] rounded-xl px-4 py-3">
          <img src="${item.imagen_url || 'https://placehold.co/48x64/1A1A1D/A78BFA?text=XDG'}"
               class="w-10 h-14 object-cover rounded-lg shrink-0" alt="${item.titulo}" />
          <div class="flex-1 min-w-0">
            <p class="text-white text-sm font-semibold truncate">${item.titulo}</p>
            <p class="text-[#A78BFA] text-sm font-bold mt-0.5">S/ ${Number(item.precio).toFixed(2)}</p>
          </div>
          <div class="flex gap-2 shrink-0">
            <a href="/detail/${item.juego_id}"
               class="bg-[#A78BFA] hover:brightness-110 text-black text-xs font-bold px-3 py-1.5 rounded-lg transition-all">
              Ver
            </a>
            <button data-wid="${item.wishlist_id}"
                    class="remove-wish bg-[#2A2633] hover:bg-red-900/40 text-[#71717A] hover:text-red-400 text-xs px-3 py-1.5 rounded-lg transition-all">
              ✕
            </button>
          </div>
        </div>`).join("");
 
      el.querySelectorAll<HTMLButtonElement>(".remove-wish").forEach(btn => {
        btn.addEventListener("click", async () => {
          await fetch(`${API}/api/wishlist.jsp`, {
            method: "DELETE", credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: btn.dataset.wid }),
          });
          loadWishlist();
        });
      });
    } catch { el.innerHTML = `<p class="text-red-400 text-sm text-center py-8">Error al cargar wishlist.</p>`; }
  }
</script>