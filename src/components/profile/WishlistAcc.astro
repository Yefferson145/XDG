<section id="wishlist">

  <div class="flex items-center gap-3 mb-6">
    <span class="w-1 h-6 bg-[#A78BFA] rounded-full block"></span>
    <h2 class="text-white font-bold text-xl tracking-tight">Lista de Deseos</h2>
  </div>

  <div id="wishlistLista" class="flex flex-col gap-3">

    <div class="wishlist-item bg-[#1A1A1D] border border-[#27272A] hover:border-[#A78BFA] rounded-xl p-4 flex items-center gap-4 transition-all group">
      <figure class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
        <img src="https://placehold.co/64x64/1A1A1D/f4710a?text=?" alt="Tales of Arise"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
      </figure>
      <div class="flex-1 min-w-0">
        <a href="/" class="text-white hover:text-[#A78BFA] font-semibold text-sm truncate block transition-colors cursor-pointer">Tales of Arise</a>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-[#A78BFA] font-bold text-sm">S/.79.99</span>
          <span class="text-[#71717A] text-xs line-through">S/.159.99</span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
  <button onclick="window.location.href='/shopping'" class="bg-[#A78BFA] hover:bg-[#8B5CF6] text-black p-2 rounded-lg transition-all" title="Agregar al carrito">            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 20q-.824 0-1.412-.587A1.93 1.93 0 0 1 4 18q0-.824.588-1.413A1.93 1.93 0 0 1 6 16q.824 0 1.412.587Q8 17.176 8 18t-.588 1.413A1.93 1.93 0 0 1 6 20m10 0q-.825 0-1.412-.587A1.93 1.93 0 0 1 14 18q0-.824.588-1.413A1.93 1.93 0 0 1 16 16q.824 0 1.413.587Q18 17.176 18 18t-.587 1.413A1.93 1.93 0 0 1 16 20M5.15 4l2.4 5h7l2.75-5zM4.2 2h14.75q.575 0 .875.513.3.512.025 1.037l-3.55 6.4q-.275.5-.738.775A1.95 1.95 0 0 1 14.55 11H7.1L6 13h12v2H6q-1.125 0-1.7-.988-.575-.987-.05-1.962L5.6 9.6 2 2H0V0h3.25zm3.35 7h7z"/>
   </svg>
        </button>
        <button class="btn-quitar text-[#71717A] hover:text-red-400 p-2 rounded-lg hover:bg-red-500/10 transition-all" title="Quitar">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="wishlist-item bg-[#1A1A1D] border border-[#27272A] hover:border-[#A78BFA] rounded-xl p-4 flex items-center gap-4 transition-all group">
      <figure class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
      <img src="https://placehold.co/64x64/1A1A1D/A78BFA?text=?" alt="No Rest for the Wicked"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
  </figure>
      <div class="flex-1 min-w-0">
    <a href="/" class="text-white hover:text-[#A78BFA] font-semibold text-sm truncate block transition-colors cursor-pointer">No Rest for the Wicked</a>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-[#A78BFA] font-bold text-sm">S/.65</span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
  <button onclick="window.location.href='/shopping'" class="bg-[#A78BFA] hover:bg-[#8B5CF6] text-black p-2 rounded-lg transition-all" title="Agregar al carrito">          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 20q-.824 0-1.412-.587A1.93 1.93 0 0 1 4 18q0-.824.588-1.413A1.93 1.93 0 0 1 6 16q.824 0 1.412.587Q8 17.176 8 18t-.588 1.413A1.93 1.93 0 0 1 6 20m10 0q-.825 0-1.412-.587A1.93 1.93 0 0 1 14 18q0-.824.588-1.413A1.93 1.93 0 0 1 16 16q.824 0 1.413.587Q18 17.176 18 18t-.587 1.413A1.93 1.93 0 0 1 16 20M5.15 4l2.4 5h7l2.75-5zM4.2 2h14.75q.575 0 .875.513.3.512.025 1.037l-3.55 6.4q-.275.5-.738.775A1.95 1.95 0 0 1 14.55 11H7.1L6 13h12v2H6q-1.125 0-1.7-.988-.575-.987-.05-1.962L5.6 9.6 2 2H0V0h3.25zm3.35 7h7z"/>
    </svg>
        </button>
        <button class="btn-quitar text-[#71717A] hover:text-red-400 p-2 rounded-lg hover:bg-red-500/10 transition-all" title="Quitar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
      </div>
  </div>

  </div>

  <div id="wishlistVacia" class="hidden bg-[#1A1A1D] border border-[#27272A] rounded-2xl p-12 text-center">
    <p class="text-[#71717A] text-sm">Tu lista de deseos está vacía.</p>
    <a href="/"
      class="mt-4 inline-flex items-center gap-2 bg-[#A78BFA] hover:bg-[#8B5CF6] text-black font-bold text-xs px-6 py-3 rounded-lg transition-all uppercase tracking-wider">
      Agregar juegos
  
    </a>
  </div>
</section>




<script>
  document.querySelectorAll('.btn-quitar').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const item=btn.closest('.wishlist-item')as HTMLElement;
      item.style.opacity='0';
      item.style.transform='translateX(20px)';
      item.style.transition='all 0.3s ease';
      setTimeout(()=>{
        item.remove();
        const lista=document.getElementById('wishlistLista');
        if (lista&&lista.querySelectorAll('.wishlist-item').length ===0) {
          document.getElementById('wishlistVacia')?.classList.remove('hidden');
        }  }, 300);
    });
  });
  
  document.querySelectorAll('.btn-quitar').forEach(btn=> {
    btn.addEventListener('click', ()=> {
      const item = btn.closest('.wishlist-item')as HTMLElement;
      item.style.opacity='0';
      item.style.transform='translateX(20px)';
      item.style.transition='all 0.3s ease';
      setTimeout(()=>{
        item.remove();
        const lista=document.getElementById('wishlistLista');
        if(lista&&lista.querySelectorAll('.wishlist-item').length ===0) {
          document.getElementById('wishlistVacia')?.classList.remove('hidden');}
      }, 300);
    });
  });
</script>
  
   


