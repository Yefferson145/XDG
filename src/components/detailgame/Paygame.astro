---
import Button from '../Button.astro';

interface Props {
  title?: string;
  edition?: string;
  price?: string;
  originalPrice?: string;
}

const { 
  title = "Starfield", 
  edition = "STANDARD EDITION", 
  price = "$69.99", 
  originalPrice = "$79.99" 
} = Astro.props;
---

<div class="bg-[#121214] border border-zinc-800/50 p-6 rounded-2xl w-full max-w-[380px] font-space shadow-2xl">
  <div class="flex justify-between items-start mb-8">
    <div class="flex flex-col gap-1">
      <span class="text-zinc-500 font-bold text-[11px] uppercase tracking-[0.15em]">
        {edition}
      </span>
      <h2 class="text-white text-3xl font-bold tracking-tight leading-none">
        {title}
      </h2>
    </div>
    <div class="text-right">
      <span class="text-zinc-500 line-through text-[13px] block mb-1">{originalPrice}</span>
      <span class="text-white text-4xl font-bold leading-none">{price}</span>
    </div>
  </div>

  <div class="flex flex-col gap-3 mb-6">
    
    <Button 
      text="Compra Ahora" 
      bgColor="bg-[#f4710a]" 
      hoverColor="hover:bg-[#ff8a2b]" 
      textColor="text-black"
      rounded="rounded-lg"
      paddingY="py-3.5"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" fill="none" slot="icon" viewBox="0 0 16 20"><path fill="#000000" d="m6.55 16.2 5.175-6.2h-4l.725-5.675L3.825 11H7.3zM4 20l1-7H0L9 0h2l-1 8h6L6 20z"/></svg>
    </Button>

    <Button 
      text="Añadir a Carrito" 
      bgColor="bg-[#a078ff]" 
      hoverColor="hover:bg-[#b794ff]" 
      textColor="text-[#2d0066]"
      rounded="rounded-lg"
      paddingY="py-3.5"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20"><path fill="#340080" d="M6 20q-.824 0-1.412-.587A1.93 1.93 0 0 1 4 18q0-.824.588-1.413A1.93 1.93 0 0 1 6 16q.824 0 1.412.587Q8 17.176 8 18t-.588 1.413A1.93 1.93 0 0 1 6 20m10 0q-.825 0-1.412-.587A1.93 1.93 0 0 1 14 18q0-.824.588-1.413A1.93 1.93 0 0 1 16 16q.824 0 1.413.587Q18 17.176 18 18t-.587 1.413A1.93 1.93 0 0 1 16 20M5.15 4l2.4 5h7l2.75-5zM4.2 2h14.75q.575 0 .875.513.3.512.025 1.037l-3.55 6.4q-.275.5-.738.775A1.95 1.95 0 0 1 14.55 11H7.1L6 13h12v2H6q-1.125 0-1.7-.988-.575-.987-.05-1.962L5.6 9.6 2 2H0V0h3.25zm3.35 7h7z"/></svg>

    </Button>

    <Button 
      text="Añadir a Lista de Deseos" 
      bgColor="bg-transparent" 
      hoverColor="hover:bg-white/5" 
      textColor="text-zinc-300 border border-zinc-800"
      rounded="rounded-lg"
      paddingY="py-3.5"
    >
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
      </svg>
    </Button>

  </div>

  <div class="pt-4 border-t border-zinc-800/60 flex justify-between items-center opacity-50">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="12" height="15" fill="none" viewBox="0 0 12 15"><path fill="#a078ff" d="M5.213 10.163 9.45 5.924 8.381 4.856 5.213 8.025 3.638 6.45l-1.07 1.069zM6 15q-2.606-.656-4.303-2.99T0 6.824V2.25L6 0l6 2.25v4.575q0 2.85-1.697 5.184T6 15m0-1.575q1.95-.62 3.225-2.475A7.1 7.1 0 0 0 10.5 6.825V3.281L6 1.594 1.5 3.28v3.544q0 2.27 1.275 4.125Q4.05 12.807 6 13.425"/></svg>
      <span class="text-[10px] text-white font-bold uppercase tracking-tight">XDG Guard Protected</span>
    </div>
  </div>
</div>

