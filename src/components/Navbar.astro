<script>
    const btn = document.getElementById("openModal") as HTMLButtonElement;
    const logoutBtn = document.getElementById("logoutBtn") as HTMLButtonElement;

    btn?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-login-modal"));
    });

    window.addEventListener("user-logged-in", (e: any) => {
        btn.textContent = `Hola, ${e.detail.nombre}`;
        btn.classList.remove("hover:border-[#A78BFA]");
        btn.style.pointerEvents = "none";
        logoutBtn.classList.remove("hidden");
    });

logoutBtn?.addEventListener("click", async () => {
    await fetch("http://localhost:8080/api/auth.jsp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ action: "logout" }),
    });

    btn.textContent = "Iniciar sesión";
    btn.classList.add("hover:border-[#A78BFA]");
    btn.style.pointerEvents = "auto";
    logoutBtn.classList.add("hidden");
    window.dispatchEvent(new CustomEvent("user-logged-out"));
});

async function checkSession() {
    try {
        const res = await fetch("http://localhost:8080/api/session.jsp", {
            credentials: "include",
        });
        const data = await res.json();
        if (data.logged) {
            btn.textContent = `Hola, ${data.name}`;
            btn.classList.remove("hover:border-[#A78BFA]");
            btn.style.pointerEvents = "none";
            logoutBtn.classList.remove("hidden");
        }
    } catch (err) {
        console.error("Error al verificar sesión:", err);
    }
}

checkSession();
</script>
