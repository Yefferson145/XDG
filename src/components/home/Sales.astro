---
---

<div class="max-w-360 mx-auto font-space">
  <div class="flex justify-between items-end mb-6">
    <div>
      <h1 class="text-2xl text-white pb-1">Ofertas y Descuentos</h1>
      <p class="text-xs text-[#71717A]">Los mejores precios por tiempo limitado.</p>
    </div>
    <div class="flex items-center gap-2">
      <button id="discPrev" class="p-2 rounded-lg bg-[#211E27] border border-[#2A2633] text-[#71717A] hover:border-[#A78BFA] hover:text-white transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="discNext" class="p-2 rounded-lg bg-[#211E27] border border-[#2A2633] text-[#71717A] hover:border-[#A78BFA] hover:text-white transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <a href="/explore" class="ml-2 text-sm text-[#D0BCFF] hover:border-b border-[#D0BCFF]">Ver todos</a>
    </div>
  </div>
  <div class="overflow-hidden">
    <div id="discTrack" class="flex gap-6 transition-transform duration-500 ease-in-out"></div>
  </div>
  <div id="discEmpty" class="hidden text-center text-[#71717A] py-20">No hay ofertas disponibles en este momento.</div>
</div>

<script>
  const API = "http://localhost:8080";
  const CARD_WIDTH = 310;
  const AUTO_INTERVAL = 10000;

  function cardHTML(juego: any) {
    return `
      <a href="/detail/${juego.id}" class="flex-shrink-0 w-[324px] flex flex-col bg-[#1A1A1D] rounded-xl overflow-hidden border border-[#27272A] hover:border-[#A78BFA] transition-all duration-300 group cursor-pointer">
        <figure class="relative aspect-[3/4] overflow-hidden">
          <span class="absolute top-2 left-2 z-10 bg-[#A78BFA] text-[#09090B] text-xs font-bold px-2 py-0.5 rounded-md">-${Math.round(juego.porcentaje)}%</span>
          <img src="${juego.imagen_url || "https://placehold.co/300x400/1A1A1D/A78BFA?text=XDG"}" alt="${juego.titulo}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </figure>
        <div class="p-4 flex flex-col grow justify-between">
          <div>
            <h3 class="text-white font-bold text-lg truncate">${juego.titulo}</h3>
            <p class="text-[#71717A] text-xs mt-1 line-clamp-2">${juego.descripcion || ""}</p>
          </div>
          <div class="mt-4 flex justify-between items-center">
            <div class="flex flex-col">
              <span class="text-[#71717A] text-xs line-through">$${Number(juego.precio_original).toFixed(2)}</span>
              <span class="text-[#A78BFA] font-semibold">$${Number(juego.precio).toFixed(2)}</span>
            </div>
            <button class="bg-[#27272A] text-white p-2 rounded-full hover:bg-[#A78BFA] hover:text-[#09090B] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </button>
          </div>
        </div>
      </a>`;
  }

  async function init() {
    const track = document.getElementById("discTrack")!;
    const empty = document.getElementById("discEmpty")!;
    try {
      const res = await fetch(`${API}/api/juegos.jsp`, { credentials: "include" });
      const games = await res.json();
      const discounted = games.filter((g: any) => g.porcentaje != null && Number(g.porcentaje) > 0);

      if (discounted.length === 0) { empty.classList.remove("hidden"); return; }

      track.innerHTML = discounted.map(cardHTML).join("");

      let index = 0;
      const max = Math.max(0, discounted.length - 4);

      function goTo(i: number) {
        index = Math.max(0, Math.min(i, max));
        track.style.transform = `translateX(-${index * CARD_WIDTH}px)`;
      }

      let timer = setInterval(() => { index = index >= max ? 0 : index + 1; goTo(index); }, AUTO_INTERVAL);

      document.getElementById("discPrev")!.addEventListener("click", () => { clearInterval(timer); goTo(index - 1); });
      document.getElementById("discNext")!.addEventListener("click", () => { clearInterval(timer); goTo(index + 1); });
    } catch {
      track.innerHTML = `<div class="text-[#71717A] py-20">No se pudieron cargar las ofertas.</div>`;
    }
  }

  init();
</script>