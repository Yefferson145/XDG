---
import CarouselSection from "../home/CarouselSection.astro";
---

<div class="font-space w-full px-4 opacity-0 transition-opacity duration-700 ease-in-out" id="home-sections">
  <CarouselSection
    id="destacados"
    title="Juegos Destacados"
    subtitle="Los títulos más populares de nuestra tienda."
