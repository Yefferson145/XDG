---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LoginCard from '../../components/login/LoginCard.astro';
---
    <LoginCard />
    <Navbar />
    <main class="w-full px-6 max-w-360 mx-auto">
        <div id="gamesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {Array.from({ length: 12 }).map(() => (
                <div class="bg-[#1A1A1D] border border-[#27272A] rounded-xl aspect-3/4 animate-pulse" />
            ))}
        </div>
    </main>
    <Footer />

<script>
    const API = "http://localhost:8080";

    function cardHTML(juego: any) {
        const hasDiscount = juego.porcentaje != null && Number(juego.porcentaje) > 0;

        return `
        <a href="/detail/${juego.id}" class="flex flex-col bg-[#1A1A1D] rounded-xl overflow-hidden border border-[#27272A] hover:border-[#A78BFA] transition-all duration-300 group cursor-pointer">
            <figure class="relative aspect-[3/4] overflow-hidden">
                ${hasDiscount ? `<span class="absolute top-2 left-2 z-10 bg-[#A78BFA] text-[#09090B] text-xs font-bold px-2 py-0.5 rounded-md">-${Math.round(juego.porcentaje)}%</span>` : ""}
                <img src="${juego.imagen_url || "https://placehold.co/300x400/1A1A1D/A78BFA?text=XDG"}" alt="Portada de ${juego.titulo}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </figure>
            <div class="p-4 flex flex-col grow justify-between">
                <div>
                    <h3 class="text-white font-bold text-lg truncate">${juego.titulo}</h3>
                    <p class="text-[#71717A] text-xs mt-1 line-clamp-2">${juego.descripcion || ""}</p>
                </div>
                <div class="mt-4 flex justify-between items-center">
                    <div class="flex flex-col">
                        ${hasDiscount ? `<span class="text-[#71717A] text-xs line-through">$${Number(juego.precio_original).toFixed(2)}</span>` : ""}
                        <span class="${hasDiscount ? "text-[#A78BFA]" : "text-white"} font-semibold">$${Number(juego.precio).toFixed(2)}</span>
                    </div>
                    <button class="bg-[#27272A] text-white p-2 rounded-full hover:bg-[#A78BFA] hover:text-[#09090B] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                </div>
            </div>
        </a>`;
    }

    async function loadGames() {
        const grid = document.getElementById("gamesGrid")!;
        try {
            const res = await fetch(`${API}/api/juegos.jsp`, { credentials: "include" });
            const games = await res.json();
            grid.innerHTML = games.map(cardHTML).join("");
        } catch {
            grid.innerHTML = `<div class="col-span-4 text-center text-[#71717A] py-20">No se pudieron cargar los juegos.</div>`;
        }
    }

    loadGames();
</script>