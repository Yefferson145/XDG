---
import API from "../../../env";
---

<section id="carrusel-section" class="admin-section p-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      Actualizar Carrusel
    </h1>
    <span class="text-gray-400 text-sm bg-gray-800 px-3 py-1 rounded-full border border-gray-700">Máximo 5 juegos</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="bg-[#18181B] border border-gray-800 rounded-xl p-6">
      <h2 class="text-xl font-bold text-white mb-6 border-b border-gray-800 pb-4">Buscar y Agregar Juego</h2>
      <div class="flex gap-3 mb-6">
        <input type="text" id="buscarJuegoCarrusel" placeholder="Escribe el nombre del juego..." class="flex-1 bg-[#27272A] border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-[#8B5CF6] transition-colors" />
        <select id="filtroCategoriaCarrusel" class="w-1/3 bg-[#27272A] border border-gray-700 rounded-lg px-3 py-3 text-white focus:outline-none focus:border-[#8B5CF6] transition-colors">
          <option value="">Todas las Categorías</option>
        </select>
        <button id="btnBuscarJuegoCarrusel" class="bg-[#8B5CF6] hover:bg-[#7C3AED] text-white px-6 py-3 rounded-lg font-semibold transition-colors whitespace-nowrap">
          Buscar
        </button>
      </div>
      <div id="resultadosBusquedaCarrusel" class="space-y-3 max-h-96 overflow-y-auto pr-2 custom-scrollbar">
      </div>
    </div>

    <div class="bg-[#18181B] border border-[#8B5CF6]/30 rounded-xl p-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-[#8B5CF6]/5 rounded-bl-full pointer-events-none"></div>
      <h2 class="text-xl font-bold text-white mb-6 border-b border-gray-800 pb-4 flex justify-between items-center">
        Juegos en el Carrusel
        <span id="contadorCarrusel" class="text-sm bg-[#8B5CF6]/20 text-[#A78BFA] px-2 py-1 rounded-md">0 / 5</span>
      </h2>
      <div id="juegosEnCarrusel" class="space-y-4">
      </div>
    </div>
  </div>
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #18181B; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #3F3F46; 
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #52525B; 
  }
</style>

<script>
  const API = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";
  
  let juegosCarrusel: any[] = [];
  
  async function cargarJuegosCarrusel() {
    try {
      const res = await fetch(`${API}/api/carrusel.jsp`, { cache: "no-store" });
      if (res.ok) {
        juegosCarrusel = await res.json();
        renderizarJuegosCarrusel();
      }
    } catch (e) {
      console.error(e);
    }
  }

  function renderizarJuegosCarrusel() {
    const contenedor = document.getElementById("juegosEnCarrusel");
    const contador = document.getElementById("contadorCarrusel");
    if (!contenedor || !contador) return;

    contador.textContent = `${juegosCarrusel.length} / 5`;
    
    if (juegosCarrusel.length === 0) {
      contenedor.innerHTML = `<div class="text-center text-gray-500 py-8 italic border border-dashed border-gray-700 rounded-lg">El carrusel está vacío. Añade juegos desde la izquierda.</div>`;
      return;
    }

    let html = "";
    juegosCarrusel.forEach(j => {
      html += `
        <div class="flex items-center gap-4 bg-[#27272A] p-3 rounded-lg border border-gray-700 hover:border-[#8B5CF6]/50 transition-colors group">
          <img src="${j.imagen_url}" alt="${j.titulo}" class="w-20 h-14 object-cover rounded-md shadow-md" />
          <div class="flex-1 min-w-0">
            <h3 class="text-white font-semibold truncate">${j.titulo}</h3>
            <p class="text-gray-400 text-sm">S/ ${j.precio.toFixed(2)}</p>
          </div>
          <button onclick="removerDelCarrusel(${j.id})" class="p-2 text-gray-500 hover:text-red-400 hover:bg-red-400/10 rounded-lg transition-colors" title="Quitar del carrusel">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
          </button>
        </div>
      `;
    });
    contenedor.innerHTML = html;
  }

  window.removerDelCarrusel = async (id: number) => {
    try {
      const res = await fetch(`${API}/api/carrusel_admin.jsp`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "remove", juego_id: id }),
        credentials: "include"
      });
      const data = await res.json();
      if (data.success) {
        await cargarJuegosCarrusel();
      } else {
        alert("Error: " + data.error);
      }
    } catch (e) {
      alert("Error de conexión");
    }
  };

  window.agregarAlCarrusel = async (id: number) => {
    if (juegosCarrusel.length >= 5) {
      alert("No puedes agregar más de 5 juegos al carrusel.");
      return;
    }
    
    try {
      const res = await fetch(`${API}/api/carrusel_admin.jsp`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "add", juego_id: id }),
        credentials: "include"
      });
      const data = await res.json();
      if (data.success) {
        await cargarJuegosCarrusel();
      } else {
        alert("Error: " + data.error);
      }
    } catch (e) {
      alert("Error de conexión");
    }
  };

  const btnBuscar = document.getElementById("btnBuscarJuegoCarrusel");
  const inputBuscar = document.getElementById("buscarJuegoCarrusel") as HTMLInputElement;
  const selectCategoria = document.getElementById("filtroCategoriaCarrusel") as HTMLSelectElement;
  const resultadosBusqueda = document.getElementById("resultadosBusquedaCarrusel");

  async function cargarCategoriasFiltro() {
    try {
      const res = await fetch(`${API}/api/categorias.jsp`, { cache: "no-store" });
      if (res.ok) {
        const categorias = await res.json();
        if (selectCategoria) {
          categorias.forEach((c: any) => {
            selectCategoria.innerHTML += `<option value="${c.id}">${c.nombre}</option>`;
          });
        }
      }
    } catch (e) {
      console.error("Error al cargar categorías", e);
    }
  }

  if (btnBuscar && inputBuscar && resultadosBusqueda) {
    btnBuscar.addEventListener("click", async () => {
      const q = inputBuscar.value.trim().toLowerCase();
      const cat = selectCategoria ? selectCategoria.value : "";
      resultadosBusqueda.innerHTML = `<div class="text-center text-gray-400 py-4">Buscando...</div>`;
      
      try {
        const res = await fetch(`${API}/api/juegos_admin.jsp`, { credentials: "include", cache: "no-store" });
        if (res.ok) {
          const todos = await res.json();
          let filtrados = todos;
          
          if (cat) {
            filtrados = filtrados.filter((j: any) => String(j.categoria_id) === cat);
          }
          if (q) {
            filtrados = filtrados.filter((j: any) => j.titulo.toLowerCase().includes(q));
          }
          
          // Deduplicar juegos por id (si tienen múltiples categorías)
          const unicos = new Map();
          filtrados.forEach((j: any) => {
            if (!unicos.has(j.id)) unicos.set(j.id, j);
          });
          filtrados = Array.from(unicos.values());
          
          if (filtrados.length === 0) {
            resultadosBusqueda.innerHTML = `<div class="text-center text-gray-500 py-4">No se encontraron resultados.</div>`;
            return;
          }

          let html = "";
          filtrados.forEach((j: any) => {
            const yaEsta = juegosCarrusel.some(c => c.id === j.id);
            html += `
              <div class="flex items-center gap-3 bg-[#18181B] p-3 rounded-lg border border-gray-800">
                <img src="${j.imagen_url}" alt="${j.titulo}" class="w-16 h-12 object-cover rounded shadow-md" />
                <div class="flex-1 min-w-0">
                  <h4 class="text-white text-sm font-semibold truncate" title="${j.titulo}">${j.titulo}</h4>
                </div>
                ${yaEsta ? 
                  `<span class="text-xs bg-[#8B5CF6]/20 text-[#A78BFA] px-2 py-1 rounded border border-[#8B5CF6]/30">Agregado</span>` :
                  `<button onclick="agregarAlCarrusel(${j.id})" class="text-xs bg-[#27272A] hover:bg-[#8B5CF6] text-white px-3 py-1.5 rounded transition-colors">Añadir</button>`
                }
              </div>
            `;
          });
          resultadosBusqueda.innerHTML = html;
        }
      } catch (e) {
        resultadosBusqueda.innerHTML = `<div class="text-center text-red-400 py-4">Error al buscar</div>`;
      }
    });

    inputBuscar.addEventListener("keypress", (e) => {
      if (e.key === "Enter") btnBuscar.click();
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    cargarCategoriasFiltro();
    cargarJuegosCarrusel();
  });
</script>

