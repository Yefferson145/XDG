<div
    id="quick-edit-panel"
    class="hidden flex-none shrink-0 w-85"
>
    <div
        class="rounded-2xl border border-[#262629]
               bg-[#17171A]/70 overflow-hidden
               hover:border-[#A970FF]
               transition-colors"
    >

        <div class="px-6 py-5 border-b border-[#262629] flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white">
                Editar Descuento
            </h2>

            <button
                onclick="document.getElementById('quick-edit-panel').classList.add('hidden')"
                class="text-zinc-500 hover:text-white transition"
            >
                ✕
            </button>
        </div>

        <div class="p-6 space-y-6">

            <div
                class="flex items-center gap-4 p-4
                       bg-[#1A1A1D]
                       border border-[#262629]
                       rounded-xl"
            >
                <img
                    id="edit-game-img"
                    src="https://placehold.co/80x120"
                    class="w-12 h-16 rounded-lg object-cover"
                />

                <div>
                    <p
                        id="edit-game-title"
                        class="text-white font-medium"
                    >
                        Neon Protocol 2.0
                    </p>

                    <p
                        id="edit-game-category"
                        class="text-xs text-zinc-500"
                    >
                        RPG Acción
                    </p>
                </div>
            </div>

            <div>
                <label class="block text-xs uppercase text-zinc-500 mb-4">
                    Descuento Individual
                </label>

                <div class="flex items-center gap-4">
                    <input
                        id="edit-discount-range"
                        type="range"
                        min="0"
                        max="90"
                        step="5"
                        value="0"
                        class="flex-1 accent-[#A970FF]"
                        oninput="document.getElementById('discount-display').textContent=this.value+'%'"
                    />

                    <span
                        id="discount-display"
                        class="text-2xl text-white font-semibold min-w-15"
                    >
                        0%
                    </span>
                </div>
            </div>

            <div>
                <label class="block text-xs uppercase text-zinc-500 mb-3">
                    Duración
                </label>

                <div class="grid grid-cols-2 gap-3">
                    <input
                        type="date"
                        class="bg-[#1A1A1D]
                               border border-[#262629]
                               rounded-lg px-3 py-2
                               text-sm text-white"
                    />

                    <input
                        type="date"
                        class="bg-[#1A1A1D]
                               border border-[#262629]
                               rounded-lg px-3 py-2
                               text-sm text-white"
                    />
                </div>
            </div>

            <button
                class="w-full h-12
                       rounded-xl
                       bg-[#A970FF]
                       text-[#1D0D3B]
                       font-semibold
                       transition-all
                       hover:brightness-110
                       active:scale-95"
            >
                Aplicar Descuento
            </button>
        </div>

        <div
            class="px-5 py-4 border-t border-[#262629]
                   bg-[#A970FF]/5"
        >
            <p class="text-xs text-zinc-400">
                Los cambios solo afectarán al juego seleccionado.
            </p>
        </div>

    </div>
</div>