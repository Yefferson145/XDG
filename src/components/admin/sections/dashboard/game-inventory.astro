---
import ModalDes from "../../sections/dashboard/modal-des.astro";
---

<div class="flex flex-nowrap gap-6 pr-4 items-start">
  <div class="w-full max-w-full font-space">
    <div
      class="rounded-2xl border border-[#262629] bg-[#17171A]/70 overflow-hidden hover:border-[#A970FF] transition-colors"
    >
      <div class="px-6 py-5 border-b border-[#262629] flex items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Inventario de Juegos</h2>
          <p class="text-[#71717A] text-xs mt-2">Presiona editar para ir al formulario de registro rápidamente.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <select id="inventoryCategorySelect" class="rounded-full border border-[#27272A] bg-[#0F0F14] px-3 py-2 text-xs text-white focus:outline-none">
            <option value="">Todas categorías</option>
          </select>
          <button id="reloadInventory" class="rounded-full border border-[#27272A] px-4 py-2 text-xs text-[#A78BFA] hover:bg-[#A78BFA]/10 transition-colors">Refrescar</button>
          <button id="newInventoryGame" class="rounded-full bg-[#A78BFA] px-4 py-2 text-xs font-semibold text-black hover:brightness-110 transition-all">Agregar juego</button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px]">
          <thead>
            <tr class="border-b border-[#262629] bg-[#111214]">
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]">Juego</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]">Categoría</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]">Precio</th>
              <th class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]">Descuento</th>
              <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase text-[#A1A1AA]">Acciones</th>
            </tr>
          </thead>
          <tbody id="inventoryBody">
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-[#71717A] text-sm">Cargando inventario...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="border-t border-[#262629] px-6 py-4 flex items-center justify-between gap-4">
        <span class="text-xs uppercase tracking-wider text-[#71717A]">Mostrando inventario activo</span>
        <div class="flex items-center gap-3">
          <button id="prevPageBtn" class="text-sm text-center text-zinc-400 hover:text-white transition-colors" style="display:none">
            Anterior
          </button>
          <button id="nextPageBtn" class="text-sm text-center text-zinc-400 hover:text-white transition-colors">
            Siguiente
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<ModalDes />

<script>
  const API = "http://localhost:8080";
  let inventario: any[] = [];
  let inventarioFiltrado: any[] = [];
  let currentPage = 0;
  const pageSize = 10;
  let categoriasMap: Record<string,string> = {};
  let currentCategoryFilter = "";
  let lastSearch = "";

  function formatCurrency(value: number) {
    return `S/ ${value.toFixed(2)}`;
  }

  function renderInventario() {
    const tbody = document.getElementById("inventoryBody")!;
    if (inventarioFiltrado.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-[#71717A] text-sm">No se encontraron juegos.</td>
        </tr>
      `;
      updateNextButton();
      return;
    }

    const start = currentPage * pageSize;
    const end = start + pageSize;
    const pageItems = inventarioFiltrado.slice(start, end);

    tbody.innerHTML = pageItems
      .map((juego) => {
        const precioActual = Number(juego.precio || 0);
        const precioOriginal = Number(juego.precio_original != null ? juego.precio_original : (juego.precio || 0));
        const descuentoManual = Number(juego.porcentaje ?? juego.descuento_porcentaje ?? 0);
        const descuentoCalculated = precioOriginal > precioActual ? Math.round((1 - precioActual / precioOriginal) * 100) : 0;
        const descuento = descuentoManual > 0 ? descuentoManual : descuentoCalculated;
        const precioDescontado = descuento > 0 ? Number((precioOriginal * (1 - descuento / 100)).toFixed(2)) : precioActual;
        const displayPrice = descuento > 0 ? precioDescontado : precioActual;
        const showOriginal = descuento > 0 && precioOriginal > 0 && precioOriginal !== displayPrice;
        return `
        <tr class="border-b border-[#262629] hover:bg-white/2 transition-colors">
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              <img src="${juego.imagen_url || 'https://placehold.co/80x120'}" class="w-10 h-14 rounded-md object-cover" alt="${juego.titulo || 'Juego'}" />
              <div>
                <p class="text-white text-sm font-medium">${juego.titulo || 'Sin título'}</p>
                <p class="text-xs text-zinc-500">ID #${juego.id || '---'}</p>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 text-sm text-zinc-400">
            ${juego.categorias && juego.categorias.length ? juego.categorias.map((cat: any) => cat.nombre).filter(Boolean).join(', ') : (juego.categoria || juego.categoria_nombre || categoriasMap[String(juego.categoria_id || juego.categoriaId || juego.categoria)] || juego.categoriaId || juego.categoria_id || 'Sin categoría')}
          </td>
          <td class="px-6 py-4 text-sm text-zinc-300">
            ${formatCurrency(displayPrice)}
            ${showOriginal ? `<div class="text-[11px] text-[#71717A] line-through">${formatCurrency(precioOriginal)}</div>` : ''}
          </td>
          <td class="px-6 py-4">
            ${descuento > 0 ? `<span class="px-2 py-1 rounded-md bg-[#EC6A06] text-[#4A1C00] text-[11px] font-semibold">-${descuento.toFixed(0)}%</span><button type="button" data-action="discount" data-id="${juego.id}" class="ml-2 text-zinc-500 hover:text-white transition" title="Editar descuento" aria-label="Editar descuento"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" viewBox="0 0 10 10"><path d="M2.042 4.083q-.846 0-1.444-.598A1.97 1.97 0 0 1 0 2.042Q0 1.196.598.598T2.042 0t1.443.598.598 1.444-.598 1.443-1.443.598m0-1.166q.365 0 .62-.256a.84.84 0 0 0 .255-.62.84.84 0 0 0-.256-.62.84.84 0 0 0-.62-.254.84.84 0 0 0-.62.255.84.84 0 0 0-.254.62q0 .365.255.62t.62.255m5.25 6.416q-.846 0-1.444-.598a1.97 1.97 0 0 1-.598-1.443q0-.846.598-1.444t1.444-.598 1.443.598.598 1.444-.598 1.443-1.443.598m0-1.166q.365 0 .62-.256a.84.84 0 0 0 .255-.62.84.84 0 0 0-.256-.62.84.84 0 0 0-.62-.254.84.84 0 0 0-.62.255.84.84 0 0 0-.254.62q0 .365.255.62t.62.255M.817 9.333 0 8.517 8.517 0l.816.817z"/></svg></button>` : '<span class="text-[#71717A] text-xs">—</span>'}
          </td>
          <td class="px-6 py-4">
            <div class="flex justify-end gap-2">
              <button data-action="edit" data-id="${juego.id}" class="w-8 h-8 rounded-lg text-zinc-500 hover:text-white hover:bg-[#262629] transition" title="Editar juego" aria-label="Editar juego">
                <span class="material-symbols-outlined text-[18px] flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18"><path d="M2 16h1.425L13.2 6.225 11.775 4.8 2 14.575zm-2 2v-4.25L13.2.575q.3-.275.663-.425.361-.15.762-.15.4 0 .775.15t.65.45L17.425 2q.3.275.438.65a2.17 2.17 0 0 1 0 1.512 1.9 1.9 0 0 1-.438.663L4.25 18zM16 3.4 14.6 2zm-3.525 2.125-.7-.725L13.2 6.225z"/></svg>
                </span>
              </button>
              <button data-action="delete" data-id="${juego.id}" class="w-8 h-8 rounded-lg text-zinc-500 hover:text-red-400 hover:bg-[#262629] transition" title="Eliminar juego" aria-label="Eliminar juego">
                <span class="material-symbols-outlined text-[18px] flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="18" fill="currentColor" viewBox="0 0 16 18"><path d="M3 18q-.824 0-1.412-.587A1.93 1.93 0 0 1 1 16V3H0V1h5V0h6v1h5v2h-1v13q0 .824-.588 1.413A1.93 1.93 0 0 1 13 18zM13 3H3v13h10zM5 14h2V5H5zm4 0h2V5H9zM3 3v13z"/></svg>
                </span>
              </button>
            </div>
          </td>
        </tr>
      `;
      }).join("");
    updateNextButton();
  }

  function populateCategorySelect() {
    const select = document.getElementById("inventoryCategorySelect") as HTMLSelectElement | null;
    if (!select) return;
    const options = [{ id: "", nombre: "Todas categorías" }].concat(
      Object.keys(categoriasMap).map((id) => ({ id, nombre: categoriasMap[id] }))
    );
    select.innerHTML = options.map(o => `<option value="${o.id}">${o.nombre}</option>`).join("");
    if (currentCategoryFilter) select.value = currentCategoryFilter;
  }

  function updateNextButton() {
    const nextBtn = document.getElementById("nextPageBtn") as HTMLButtonElement | null;
    if (!nextBtn) return;
    const hasMore = (currentPage + 1) * pageSize < inventarioFiltrado.length;
    nextBtn.style.display = hasMore ? "inline-block" : "none";
    const prevBtn = document.getElementById("prevPageBtn") as HTMLButtonElement | null;
    if (prevBtn) {
      prevBtn.style.display = currentPage > 0 ? "inline-block" : "none";
    }
  }

  function nextPage() {
    if ((currentPage + 1) * pageSize < inventarioFiltrado.length) {
      currentPage++;
      renderInventario();
      const content = document.getElementById("inventoryBody");
      content?.querySelector("tr")?.scrollIntoView({ behavior: "smooth" });
    }
  }

  function prevPage() {
    if (currentPage > 0) {
      currentPage--;
      renderInventario();
      const content = document.getElementById("inventoryBody");
      content?.querySelector("tr")?.scrollIntoView({ behavior: "smooth" });
    }
  }

  function filtrarInventario(query = "") {
    lastSearch = query;
    currentPage = 0;
    const valor = query.toLowerCase();
    inventarioFiltrado = inventario.filter((juego) => {
      const categoriaTexto = String(juego.categoria || juego.categoria_nombre || categoriasMap[String(juego.categoria_id || juego.categoriaId || juego.categoria)] || juego.categoriaId || juego.categoria_id || "");
      const matchesQuery = String(juego.titulo || "").toLowerCase().includes(valor) || categoriaTexto.toLowerCase().includes(valor);
      const juegoCatId = String(juego.categoria_id ?? juego.categoriaId ?? "");
      const matchesCategory = currentCategoryFilter ? juegoCatId === String(currentCategoryFilter) : true;
      return matchesQuery && matchesCategory;
    });
    renderInventario();
  }

  async function cargarInventario() {
    const tbody = document.getElementById("inventoryBody")!;
    tbody.innerHTML = `
      <tr>
        <td colspan="5" class="px-6 py-12 text-center text-[#71717A] text-sm">Cargando inventario...</td>
      </tr>
    `;

    try {
      try {
        const catRes = await fetch(`${API}/api/categorias.jsp`, { credentials: "include" });
        const catData = await catRes.json();
        const cats = Array.isArray(catData) ? catData : (catData && catData.categorias) || [];
        categoriasMap = {};
        cats.forEach(function(c: any) { if (c && c.id != null) categoriasMap[String(c.id)] = c.nombre; });
      } catch (err) {
        categoriasMap = {};
        console.warn('No se pudieron cargar categorías para mapear nombres', err);
      }

      let descuentosMap: Record<string, any> = {};
      try {
        const discRes = await fetch(`${API}/api/descuentos.jsp`, { credentials: "include" });
        const discData = await discRes.json();
        const descuentos = Array.isArray(discData) ? discData : discData.descuentos || discData.items || [];
        descuentos.forEach(function(d: any) {
          if (!d) return;
          const key = String(d.juego_id ?? d.juegoId ?? d.id ?? d.id_juego ?? "");
          if (!key) return;
          descuentosMap[key] = d;
        });
      } catch (err) {
        console.warn('No se pudieron cargar descuentos activos', err);
      }

      const res = await fetch(`${API}/api/juegos.jsp`, {
        credentials: "include",
      });
      const data = await res.json();

      const raw = Array.isArray(data) ? data : [];
      const byId: Record<string, any> = {};
      raw.forEach(function(g: any) {
        const key = String(g.id ?? g.ID ?? "");
        if (!key) return;
        const catId = g.categoria_id ?? g.categoriaId ?? null;
        const catName = g.categoria_nombre || g.categoria || "";
        const categoryItem = catId != null || catName ? { id: catId != null ? String(catId) : "", nombre: String(catName) } : null;

        if (!byId[key]) {
          byId[key] = { ...g, categorias: [] };
          if (categoryItem && categoryItem.nombre) byId[key].categorias.push(categoryItem);
          if (!byId[key].categoria_nombre && categoryItem) byId[key].categoria_nombre = categoryItem.nombre;
          if (!byId[key].categoria_id && categoryItem && categoryItem.id) byId[key].categoria_id = categoryItem.id;
        } else {
          if (categoryItem && categoryItem.nombre && !byId[key].categorias.some((c: any) => c.id === categoryItem.id && c.nombre === categoryItem.nombre)) {
            byId[key].categorias.push(categoryItem);
          }
          if (!byId[key].categoria_nombre && categoryItem) byId[key].categoria_nombre = categoryItem.nombre;
          if (!byId[key].categoria_id && categoryItem && categoryItem.id) byId[key].categoria_id = categoryItem.id;
        }
      });

      inventario = Object.keys(byId).map(k => byId[k]);
      inventario.forEach(function(game: any) {
        const d = descuentosMap[String(game.id)];
        if (d) {
          const descuento = Number(d.porcentaje ?? d.descuento_porcentaje ?? game.porcentaje ?? 0);
          const precioOriginal = Number(d.precio_original ?? d.precioOriginal ?? game.precio_original ?? game.precio ?? 0);
          const precioActual = Number(d.precio_con_descuento ?? d.precio_actual ?? 0);
          const computedPrecioActual = descuento > 0 && precioOriginal > 0
            ? Number((precioOriginal * (1 - descuento / 100)).toFixed(2))
            : 0;
          const finalPrecio = precioActual > 0 && precioActual !== precioOriginal
            ? precioActual
            : (computedPrecioActual > 0 ? computedPrecioActual : Number(game.precio ?? 0));

          game.porcentaje = descuento;
          game.precio_original = precioOriginal || finalPrecio;
          game.precio = finalPrecio;
          game.fecha_fin = d.fecha_fin ?? game.fecha_fin;
          game.fecha_inicio = d.fecha_inicio ?? game.fecha_inicio;
        } else {
          if (game.descuento_porcentaje) {
            game.porcentaje = game.descuento_porcentaje;
          }
        }
      });
      inventarioFiltrado = inventario;
      populateCategorySelect();
      currentPage = 0;
      renderInventario();
    } catch (error) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-red-400 text-sm">Error cargando inventario.</td>
        </tr>
      `;
      console.error("Error inventario:", error);
    }
  }

  async function eliminarJuego(id: string) {
    if (!id) return;
    const confirmed = confirm("¿Eliminar este juego? Esta acción no se puede deshacer.");
    if (!confirmed) return;

    try {
      const res = await fetch(`${API}/api/juegos.jsp`, {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ id }),
      });
      const result = await res.json();
      if (result.success) {
        inventario = inventario.filter((juego) => String(juego.id) !== id);
        inventarioFiltrado = inventarioFiltrado.filter((juego) => String(juego.id) !== id);
        renderInventario();
      } else {
        alert(result.error || "No se pudo eliminar el juego.");
      }
    } catch (error) {
      console.error("Error eliminar juego:", error);
      alert("No se pudo conectar al servidor.");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    cargarInventario();

    document.getElementById("reloadInventory")?.addEventListener("click", () => { currentPage = 0; cargarInventario(); });
    document.getElementById("newInventoryGame")?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-admin-section", { detail: { section: "registro-juegos" } }));
    });
    const prevBtn = document.getElementById("prevPageBtn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("nextPageBtn") as HTMLButtonElement | null;
    prevBtn?.addEventListener("click", () => prevPage());
    nextBtn?.addEventListener("click", () => nextPage());
    const catSelect = document.getElementById("inventoryCategorySelect") as HTMLSelectElement | null;
    catSelect?.addEventListener("change", (e) => {
      currentCategoryFilter = (e.target as HTMLSelectElement).value;
      filtrarInventario(lastSearch);
    });

    document.getElementById("inventoryBody")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const action = button.dataset.action;
      const id = button.dataset.id;
      if (!action || !id) return;

      const juego = inventario.find((item) => String(item.id) === id);
      if (action === "edit" && juego) {
        window.dispatchEvent(new CustomEvent("open-admin-section", { detail: { section: "registro-juegos", game: juego } }));
      }
      if (action === "discount" && juego) {
        const panel = document.getElementById("quick-edit-panel");
        if (panel) panel.classList.remove("hidden");
      }
      if (action === "delete") {
        eliminarJuego(id);
      }
    });

    window.addEventListener("admin-search", (event: any) => {
      filtrarInventario(String(event.detail?.query || ""));
    });

    window.addEventListener("inventory-updated", cargarInventario);
  });
</script>