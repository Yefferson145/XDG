---
import ModalDes from "../../sections/dashboard/modal-des.astro";

---

<div class="flex flex-nowrap gap-6 pr-4 items-start">
<div class="w-250 max-w-auto font-space">
    <div
        class="rounded-2xl border border-[#262629]
               bg-[#17171A]/70 overflow-hidden hover:border-[#A970FF] transition-colors"
    >
        <div
            class="px-6 py-5 border-b border-[#262629] flex items-center justify-between"
        >
            <h2
                class="text-sm font-semibold uppercase tracking-wider text-white"
            >
                Inventario de Juegos
            </h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-[#262629]">
                        <th
                            class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]"
                        >
                            Juego
                        </th>

                        <th
                            class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]"
                        >
                            Categoría
                        </th>

                        <th
                            class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]"
                        >
                            Precio
                        </th>

                        <th
                            class="px-6 py-4 text-left text-[11px] font-semibold uppercase text-[#A1A1AA]"
                        >
                            Descuento
                        </th>

                        <th
                            class="px-6 py-4 text-right text-[11px] font-semibold uppercase text-[#A1A1AA]"
                        >
                            Acciones
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr
                        class="border-b border-[#262629] hover:bg-white/2 transition-colors"
                    >
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <img
                                    src="https://placehold.co/80x120"
                                    class="w-10 h-14 rounded-md object-cover"
                                    alt=""
                                />

                                <div>
                                    <p class="text-white text-sm font-medium">
                                        Neon Protocol 2.0
                                    </p>

                                    <p class="text-xs text-zinc-500">
                                        ID #GAME001
                                    </p>
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4 text-sm text-zinc-400">
                            RPG Acción
                        </td>

                        <td class="px-6 py-4 text-sm text-zinc-300">
                            $59.99
                        </td>

                        <td class="px-6 py-4">
                            <span
                                class="px-2 py-1 rounded-md
                                       bg-[#EC6A06]
                                       text-[#4A1C00]
                                       text-[11px]
                                       font-semibold"
                            >
                                -25%
                            </span>
                            <!-- boton de mrda(descuento) -->
                            <button
                                class="ml-2 text-zinc-500 hover:text-white transition"
                                id="open-discount-panel"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="10"
                                    height="10"
                                    fill="currentColor"
                                    viewBox="0 0 10 10"
                                    ><path
                                        d="M2.042 4.083q-.846 0-1.444-.598A1.97 1.97 0 0 1 0 2.042Q0 1.196.598.598T2.042 0t1.443.598.598 1.444-.598 1.443-1.443.598m0-1.166q.365 0 .62-.256a.84.84 0 0 0 .255-.62.84.84 0 0 0-.256-.62.84.84 0 0 0-.62-.254.84.84 0 0 0-.62.255.84.84 0 0 0-.254.62q0 .365.255.62t.62.255m5.25 6.416q-.846 0-1.444-.598a1.97 1.97 0 0 1-.598-1.443q0-.846.598-1.444t1.444-.598 1.443.598.598 1.444-.598 1.443-1.443.598m0-1.166q.365 0 .62-.256a.84.84 0 0 0 .255-.62.84.84 0 0 0-.256-.62.84.84 0 0 0-.62-.254.84.84 0 0 0-.62.255.84.84 0 0 0-.254.62q0 .365.255.62t.62.255M.817 9.333 0 8.517 8.517 0l.816.817z"
                                    ></path></svg
                                >
                            </button>
                        </td>

                        <td class="px-6 py-4">
                            <div class="flex justify-end gap-2">
                                <button
                                    class="w-8 h-8 rounded-lg
                                           text-zinc-500
                                           hover:text-white
                                           hover:bg-[#262629]
                                           transition"
                                >
                                    <span
                                        class="material-symbols-outlined text-[18px] flex items-center justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="18"
                                            height="18"
                                            fill="currentColor"
                                            viewBox="0 0 18 18"
                                            ><path
                                                d="M2 16h1.425L13.2 6.225 11.775 4.8 2 14.575zm-2 2v-4.25L13.2.575q.3-.275.663-.425.361-.15.762-.15.4 0 .775.15t.65.45L17.425 2q.3.275.438.65a2.17 2.17 0 0 1 0 1.512 1.9 1.9 0 0 1-.438.663L4.25 18zM16 3.4 14.6 2zm-3.525 2.125-.7-.725L13.2 6.225z"
                                            ></path></svg
                                        >
                                    </span>
                                </button>

                                <button
                                    class="w-8 h-8 rounded-lg
                                           text-zinc-500
                                           hover:text-red-400
                                           hover:bg-[#262629]
                                           transition"
                                >
                                    <span
                                        class="material-symbols-outlined text-[18px] flex items-center justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="16"
                                            height="18"
                                            fill="currentColor"
                                            viewBox="0 0 16 18"
                                            ><path
                                                d="M3 18q-.824 0-1.412-.587A1.93 1.93 0 0 1 1 16V3H0V1h5V0h6v1h5v2h-1v13q0 .824-.588 1.413A1.93 1.93 0 0 1 13 18zM13 3H3v13h10zM5 14h2V5H5zm4 0h2V5H9zM3 3v13z"
                                            ></path></svg
                                        >
                                    </span>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="border-t border-[#262629] px-6 py-4 flex items-end justify-center">
            <button
                class="text-sm text-center text-zinc-400 hover:text-white transition-colors"
            >
                Ver inventario completo
            </button>
        </div>
    </div>
</div>
<ModalDes />

<script>
document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-discount-panel");
    const panel = document.getElementById("quick-edit-panel");

    if (openBtn && panel) {
        openBtn.addEventListener("click", () => {
            panel.classList.remove("hidden");
        });
    }
});
</script>