---
const monthly = [
  { label: "JAN", value: 40 },
  { label: "FEB", value: 55 },
  { label: "MAR", value: 45 },
  { label: "APR", value: 85, highlight: true },
  { label: "MAY", value: 65 },
  { label: "JUN", value: 75 },
  { label: "JUL", value: 60 },
];

const daily = [
  { label: "MON", value: 30 },
  { label: "TUE", value: 72 },
  { label: "WED", value: 50 },
  { label: "THU", value: 90, highlight: true },
  { label: "FRI", value: 48 },
  { label: "SAT", value: 35 },
  { label: "SUN", value: 20 },
];
---

<div class="rounded-[24px] border border-[#262629] bg-[#17171A]/70 p-8 overflow-hidden transition-colors duration-300 hover:border-[#A970FF]">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h2 class="text-[28px] font-medium text-white">RENDIMIENTO DE VENTAS</h2>
      <p class="text-[15px] text-[#757584] mt-1">Datos históricos para el año fiscal actual</p>
    </div>
    <div class="flex gap-2">
      <button id="btn-daily" class="px-5 py-2 rounded-md bg-white/10 text-[#c6c6cf] text-sm transition-colors duration-200">DIARIO</button>
      <button id="btn-monthly" class="px-5 py-2 rounded-md bg-[#8b5cf6] text-white text-sm transition-colors duration-200">MENSUAL</button>
    </div>
  </div>

  <div class="relative h-80">
    <!-- Lineas -->
    <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
      {[0,1,2].map(() => <div class="border-b border-white/5" />)}
      <div />
    </div>

    <!-- Barras -->
    <div id="bars-container" class="absolute inset-0 flex items-end pb-8">
      {monthly.map((m) => (
        <div class="flex-1 flex flex-col items-center justify-end h-full">
          <div
            class={`bar w-5/6 rounded-t-md transition-all duration-500 ease-out ${m.highlight ? "bg-[#8b5cf6] shadow-[0_0_30px_rgba(139,92,246,.3)]" : "bg-[#22222c]"}`}
            style="height:0%"
            data-value={m.value}
            data-highlight={m.highlight ?? false}
          />
          <span class="bar-label mt-3 text-[13px] tracking-wide text-[#7a7a86]">{m.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ monthly, daily }}>
  const btnDaily = document.getElementById("btn-daily");
  const btnMonthly = document.getElementById("btn-monthly");
  const container = document.getElementById("bars-container");
  const BASE = "bar w-5/6 rounded-t-md transition-all duration-500 ease-out";

  function activate(active, inactive) {
    active.classList.replace("bg-white/10", "bg-[#8b5cf6]");
    active.classList.replace("text-[#c6c6cf]", "text-white");
    inactive.classList.replace("bg-[#8b5cf6]", "bg-white/10");
    inactive.classList.replace("text-white", "text-[#c6c6cf]");
  }

  function renderBars(data) {
    const bars = [...container.querySelectorAll(".bar")];
    const labels = [...container.querySelectorAll(".bar-label")];

    bars.forEach((bar) => (bar.style.height = "0%"));

    setTimeout(() => {
      data.forEach((d, i) => {
        labels[i].textContent = d.label;
        bars[i].className = d.highlight
          ? `${BASE} bg-[#8b5cf6] shadow-[0_0_30px_rgba(139,92,246,.3)]`
          : `${BASE} bg-[#22222c]`;
        setTimeout(() => (bars[i].style.height = `${d.value}%`), 50);
      });
    }, 300);
  }

  setTimeout(() => renderBars(monthly), 100);
  btnDaily.addEventListener("click", () => { activate(btnDaily, btnMonthly); renderBars(daily); });
  btnMonthly.addEventListener("click", () => { activate(btnMonthly, btnDaily); renderBars(monthly); });
</script>