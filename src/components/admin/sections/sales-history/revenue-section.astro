---
---
<div class="rounded-[24px] border border-[#262629] bg-[#17171A]/70 p-8 overflow-hidden transition-colors duration-300">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h2 class="text-[28px] font-medium text-white">RENDIMIENTO DE VENTAS</h2>
      <p class="text-[15px] text-[#757584] mt-1">Evolución de los ingresos en el tiempo</p>
    </div>
    <div class="flex gap-2 items-center">
      <select id="select-days" class="px-3 py-2 rounded-md bg-[#262629] text-white text-sm outline-none border border-transparent focus:border-[#8b5cf6] transition-colors cursor-pointer">
          <option value="7">Últimos 7 días</option>
          <option value="15">Últimos 15 días</option>
          <option value="30">Últimos 30 días</option>
      </select>
      <button id="btn-daily"   class="px-5 py-2 rounded-md bg-[#8b5cf6] text-white text-sm transition-colors duration-200">DIARIO</button>
      <button id="btn-monthly" class="px-5 py-2 rounded-md bg-white/10 text-[#c6c6cf] text-sm transition-colors duration-200">MENSUAL</button>
    </div>
  </div>

  <div class="relative h-80 w-full">
    <canvas id="revenueLineChart"></canvas>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const API = "http://localhost:8080";
  const btnDaily   = document.getElementById("btn-daily")!;
  const btnMonthly = document.getElementById("btn-monthly")!;
  const selectDays = document.getElementById("select-days") as HTMLSelectElement;
  
  let monthlyData: any[] = [];
  let dailyData:   any[] = [];
  let revChartInstance: any = null;
  let currentMode = 'daily';

  function activate(active: Element, inactive: Element) {
    active.classList.remove("bg-white/10", "text-[#c6c6cf]");
    active.classList.add("bg-[#8b5cf6]", "text-white");
    inactive.classList.remove("bg-[#8b5cf6]", "text-white");
    inactive.classList.add("bg-white/10", "text-[#c6c6cf]");
  }

  function renderChart(data: any[]) {
    const ctx = document.getElementById('revenueLineChart') as HTMLCanvasElement;
    
    if (revChartInstance) {
        revChartInstance.destroy();
    }

    const labels = data.map(d => {
        const engToSpa: any = {
            'MON': 'LUN', 'TUE': 'MAR', 'WED': 'MIÉ', 'THU': 'JUE', 'FRI': 'VIE', 'SAT': 'SÁB', 'SUN': 'DOM',
            'JAN': 'ENE', 'FEB': 'FEB', 'MAR': 'MAR', 'APR': 'ABR', 'MAY': 'MAY', 'JUN': 'JUN',
            'JUL': 'JUL', 'AUG': 'AGO', 'SEP': 'SEP', 'OCT': 'OCT', 'NOV': 'NOV', 'DEC': 'DIC'
        };
        const upper = String(d.label).toUpperCase();
        return engToSpa[upper] || d.label;
    });
    const values = data.map(d => d.value);

    // @ts-ignore
    revChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Ingresos (S/)',
                data: values,
                backgroundColor: '#A78BFA',
                hoverBackgroundColor: '#8B5CF6',
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(23, 23, 26, 0.9)',
                    titleColor: '#fff',
                    bodyColor: '#A78BFA',
                    borderColor: '#262629',
                    borderWidth: 1,
                    padding: 10,
                    displayColors: false,
                    callbacks: {
                        label: function(context: any) {
                            return 'S/ ' + context.parsed.y.toLocaleString();
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: { color: '#71717A', font: { family: 'Inter', size: 12 } }
                },
                y: {
                    grid: { color: '#262629', drawBorder: false },
                    ticks: { 
                        color: '#71717A',
                        font: { family: 'Inter', size: 12 },
                        callback: function(value: any) {
                            return 'S/ ' + value.toLocaleString();
                        }
                    },
                    beginAtZero: true
                }
            }
        }
    });
  }

  async function loadStats(days: number = 7) {
    try {
      const res  = await fetch(`${API}/api/ventas-stats.jsp?days=${days}`, { credentials: "include" });
      const text = await res.text();
      const match = text.match(/\{[\s\S]*\}/);
      if (!match) return;
      const data = JSON.parse(match[0]);

      monthlyData = data.monthly || [];
      dailyData   = data.daily   || [];

      if (currentMode === 'daily') renderChart(dailyData);
      else renderChart(monthlyData);
    } catch(e) {
      console.error(e);
    }
  }

  btnDaily.addEventListener("click", () => { 
      currentMode = 'daily';
      selectDays.style.display = 'inline-block';
      activate(btnDaily, btnMonthly); 
      renderChart(dailyData); 
  });
  
  btnMonthly.addEventListener("click", () => { 
      currentMode = 'monthly';
      selectDays.style.display = 'none';
      activate(btnMonthly, btnDaily); 
      renderChart(monthlyData); 
  });

  selectDays.addEventListener("change", (e: any) => {
      loadStats(e.target.value);
  });

  window.addEventListener("section-opened", (e: any) => {
      if (e.detail?.section === "registro-ventas" && !revChartInstance) {
          loadStats(parseInt(selectDays.value));
      } else if (e.detail?.section === "registro-ventas" && revChartInstance) {
          revChartInstance.resize();
      }
  });

  // Initial load
  loadStats(7);
</script>