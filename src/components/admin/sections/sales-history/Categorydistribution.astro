---
---
<div class="rounded-[24px] border border-[#262629] bg-[#17171A]/70 p-8 flex flex-col overflow-hidden transition-all duration-300">
  <h2 class="text-[28px] font-medium text-white mb-8">Distribución por Categoría</h2>

  <div class="relative w-full h-64 flex justify-center items-center mb-6">
      <canvas id="categoryChart"></canvas>
  </div>

  <div class="mt-auto rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-xl">
    <div class="flex gap-3 items-center">
      <span class="text-[#8b5cf6] text-xl">✦</span>
      <p id="cat-insight" class="text-[14px] text-[#A1A1AA] leading-relaxed">
        Analizando datos de ventas...
      </p>
    </div>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const API = "http://localhost:8080";
  let catChartInstance: any = null;

  async function loadCategories() {
    try {
      const res  = await fetch(`${API}/api/ventas-stats.jsp`, { credentials: "include" });
      const text = await res.text();
      const match = text.match(/\{[\s\S]*\}/);
      if (!match) return;
      const data = JSON.parse(match[0]);
      const cats = data.categories || [];

      const insight = document.getElementById("cat-insight")!;

      if (!cats.length) {
        return;
      }

      const labels = cats.map((c: any) => c.label);
      const values = cats.map((c: any) => c.pct);
      const colors = cats.map((c: any) => c.color);

      const ctx = document.getElementById('categoryChart') as HTMLCanvasElement;
      
      if (catChartInstance) {
          catChartInstance.destroy();
      }

      // @ts-ignore
      catChartInstance = new Chart(ctx, {
          type: 'doughnut',
          data: {
              labels: labels,
              datasets: [{
                  data: values,
                  backgroundColor: colors,
                  borderWidth: 0,
                  hoverOffset: 4
              }]
          },
          options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '75%',
              plugins: {
                  legend: {
                      position: 'right',
                      labels: {
                          color: '#A1A1AA',
                          font: { family: 'Inter', size: 12 },
                          usePointStyle: true,
                          padding: 20
                      }
                  },
                  tooltip: {
                      backgroundColor: 'rgba(23, 23, 26, 0.9)',
                      titleColor: '#fff',
                      bodyColor: '#A78BFA',
                      borderColor: '#262629',
                      borderWidth: 1,
                      padding: 10,
                      callbacks: {
                          label: function(context: any) {
                              return ' ' + context.parsed + '%';
                          }
                      }
                  }
              }
          }
      });

      if (cats.length > 0) {
        insight.innerHTML = `La categoría <span class="text-white font-medium">${cats[0].label}</span> lidera con el <span class="text-white font-medium">${cats[0].pct}%</span> de las ventas totales.`;
      }

    } catch(e) {
      console.error(e);
    }
  }

  window.addEventListener("section-opened", (e: any) => {
      if (e.detail?.section === "registro-ventas" && !catChartInstance) {
          loadCategories();
      } else if (e.detail?.section === "registro-ventas" && catChartInstance) {
          catChartInstance.resize();
      }
  });

  loadCategories();
</script>