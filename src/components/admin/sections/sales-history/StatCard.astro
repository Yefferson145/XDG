---
interface Props {
    title: string;
    value: string;
    change: string;
    trend: "up" | "down";
    accent?: boolean;
}

const { title, value, change, trend, accent = false } = Astro.props;
---

<div
    class="relative overflow-hidden rounded-[22px] border border-[#262629] bg-[#17171A]/70 p-6 group transition-all duration-300 hover:border-[#A970FF]"
>
    <div class="absolute right-0 bottom-0 opacity-[0.04] pointer-events-none select-none">
    {title === "INGRESOS TOTALES" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="95" height="65" fill="none" viewBox="0 0 95 65"><path fill="#e7e0ed" d="M65 45q-6.25 0-10.625-4.375T50 30t4.375-10.625T65 15t10.625 4.375T80 30t-4.375 10.625T65 45M30 60q-4.125 0-7.062-2.937Q20 54.125 20 50V10q0-4.125 2.938-7.062Q25.875 0 30 0h70q4.125 0 7.062 2.938Q110 5.874 110 10v40q0 4.125-2.938 7.063Q104.125 60 100 60zm10-10h50q0-4.125 2.938-7.062Q95.875 40 100 40V20q-4.125 0-7.062-2.937Q90 14.125 90 10H40q0 4.125-2.937 7.063Q34.125 20 30 20v20q4.125 0 7.063 2.938Q40 45.875 40 50m55 30H10q-4.125 0-7.062-2.937Q0 74.125 0 70V15h10v55h85zM30 50V10z"/></svg>
    ) : title === "COMPRAS PROCESADAS" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="65" height="85" fill="none" viewBox="0 0 65 85"><path fill="#e7e0ed" d="M10 100q-4.125 0-7.062-2.937Q0 94.125 0 90V30q0-4.125 2.938-7.062Q5.874 20 10 20h10q0-8.25 5.875-14.125T40 0t14.125 5.875T60 20h10q4.125 0 7.063 2.938Q80 25.875 80 30v60q0 4.125-2.937 7.063Q74.125 100 70 100zm0-10h60V30H60v10q0 2.125-1.437 3.563Q57.125 45 55 45t-3.562-1.437T50 40V30H30v10q0 2.125-1.437 3.563Q27.125 45 25 45t-3.562-1.437T20 40V30H10zm20-70h20q0-4.125-2.937-7.062Q44.125 10 40 10t-7.062 2.938T30 20M10 90V30z"/></svg>

    ) : title === "NUEVOS CLIENTES" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="95" height="65" fill="none" viewBox="0 0 95 65"><path fill="#e7e0ed" d="M0 80V66q0-4.25 2.188-7.812Q4.374 54.624 8 52.75q7.75-3.874 15.75-5.812A68.8 68.8 0 0 1 40 45q8.25 0 16.25 1.938T72 52.75q3.625 1.875 5.813 5.438T80 66v14zm90 0V65q0-5.5-3.062-10.562-3.063-5.063-8.688-8.688 6.375.75 12 2.563 5.625 1.812 10.5 4.437 4.5 2.5 6.875 5.563Q110 61.374 110 65v15zM40 40q-8.25 0-14.125-5.875T20 20t5.875-14.125T40 0t14.125 5.875T60 20t-5.875 14.125T40 40m50-20q0 8.25-5.875 14.125T70 40q-1.375 0-3.5-.312-2.125-.313-3.5-.688a29.7 29.7 0 0 0 5.188-8.875A28.8 28.8 0 0 0 70 20q0-5.25-1.812-10.125A29.7 29.7 0 0 0 63 1a15.2 15.2 0 0 1 3.5-.812A33 33 0 0 1 70 0q8.25 0 14.125 5.875T90 20M10 70h60v-4a4.7 4.7 0 0 0-.687-2.5 4.87 4.87 0 0 0-1.813-1.75q-6.75-3.375-13.625-5.062A58 58 0 0 0 40 55q-7 0-13.875 1.688Q19.25 58.374 12.5 61.75q-1.125.625-1.812 1.75A4.7 4.7 0 0 0 10 66zm30-40q4.125 0 7.063-2.937Q50 24.125 50 20t-2.937-7.062T40 10t-7.062 2.938T30 20t2.938 7.063T40 30"/></svg>
    ) : title === "TASA DE CONVERSIÓN" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="65" height="65" fill="none" viewBox="0 0 65 65"><path fill="#e7e0ed" d="M17.5 35q-7.25 0-12.375-5.125Q0 24.749 0 17.5q0-7.25 5.125-12.375T17.5 0t12.375 5.125T35 17.5t-5.125 12.375Q24.749 35 17.5 35m0-10q3.124 0 5.313-2.187Q25 20.625 25 17.5t-2.187-5.312T17.5 10t-5.312 2.188T10 17.5q0 3.124 2.188 5.313Q14.375 25 17.5 25m45 55q-7.25 0-12.375-5.125Q45 69.749 45 62.5q0-7.25 5.125-12.375Q55.251 45 62.5 45q7.25 0 12.375 5.125Q80 55.251 80 62.5q0 7.25-5.125 12.375Q69.749 80 62.5 80m0-10q3.125 0 5.313-2.187Q70 65.624 70 62.5q0-3.125-2.187-5.312Q65.624 55 62.5 55q-3.125 0-5.312 2.188Q55 59.375 55 62.5t2.188 5.313T62.5 70M7 80l-7-7L73 0l7 7z"/></svg>
    ) : null}
</div>

    <div class="relative z-10">
        <p class="uppercase text-[14px] tracking-wide text-[#757584]">
            {title}
        </p>

        <h3
            class={`mt-4 text-[36px] font-medium ${accent ? "text-[#f6b14b]" : "text-white"}`}
        >
            {value}
        </h3>

        <div class="flex items-center gap-2 mt-4">
            <span
                class={`text-sm ${trend === "up" ? "text-[#f8b48f]" : "text-[#ff8f8f]"}`}
            >
                {trend === "up" ? "↗" : "↘"}
                {change}
            </span>

            <span class="text-sm text-[#b0a6a6]"> De el ultimo Mes</span>
        </div>
    </div>
</div>
