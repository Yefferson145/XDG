---
---
<div class="rounded-[24px] border border-[#262629] bg-[#17171A]/70 p-8 flex flex-col overflow-hidden transition-all duration-300">

  <div class="flex items-center justify-between mb-8">
    <h2 class="text-[28px] font-medium text-white">Últimas Transacciones</h2>
    <div class="flex items-center gap-3">
      <span id="tx-page-info" class="text-[12px] font-medium text-[#9ca3af]">1 - 5</span>
      <button id="btn-prev" disabled
        class="px-3 py-2 rounded-xl text-sm font-medium text-[#9ca3af] border border-[#262629] bg-[#111214] transition-colors duration-200 disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-white/[0.05] hover:enabled:text-white">
        ← Anterior
      </button>
      <button id="btn-next"
        class="px-3 py-2 rounded-xl text-sm font-medium text-[#111214] bg-[#A78BFA] transition-colors duration-200 disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-[#8B5CF6]">
        Siguiente →
      </button>
    </div>
  </div>

  <div class="grid grid-cols-5 mb-4 px-4">
    <span class="text-[12px] font-bold tracking-widest text-[#9ca3af] uppercase">Cliente</span>
    <span class="text-[12px] font-bold tracking-widest text-[#9ca3af] uppercase">Juego</span>
    <span class="text-[12px] font-bold tracking-widest text-[#9ca3af] uppercase">Fecha</span>
    <span class="text-[12px] font-bold tracking-widest text-[#9ca3af] uppercase text-center">Cantidad</span>
    <span class="text-[12px] font-bold tracking-widest text-[#9ca3af] uppercase text-right">Total</span>
  </div>

  <div id="tx-list" class="flex flex-col gap-3 min-h-[400px]">
    <p class="text-zinc-500 text-sm px-4">Cargando...</p>
  </div>

</div>

<script>
  const API  = "http://localhost:8080";
  const PAGE = 5;
  let offset  = 0;
  let hasMore = false;

  document.addEventListener("DOMContentLoaded", () => {
    const list     = document.getElementById("tx-list") as HTMLElement;
    const btnPrev  = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext  = document.getElementById("btn-next") as HTMLButtonElement;
    const pageInfo = document.getElementById("tx-page-info") as HTMLElement;

    async function loadPage() {
      list.innerHTML = `<p class="text-zinc-500 text-sm px-4">Cargando...</p>`;
      btnPrev.disabled = true;
      btnNext.disabled = true;

      try {
        const res  = await fetch(`${API}/api/ventas-stats.jsp?offset=${offset}&limit=${PAGE + 1}`, { credentials: "include" });
        const text = await res.text();

        const match = text.match(/\{[\s\S]*\}/);
        if (!match) {
          console.error("No se encontró JSON en la respuesta:", text);
          return;
        }

        const data = JSON.parse(match[0]);
        const todos: any[]  = data.transacciones || [];
        hasMore              = todos.length > PAGE;
        const ventas: any[] = todos.slice(0, PAGE);

        if (!ventas.length) {
          list.innerHTML = `<p class="text-zinc-500 text-sm px-4">Sin transacciones</p>`;
          return;
        }

        pageInfo.textContent = `${offset + 1} - ${offset + ventas.length}`;

        list.innerHTML = ventas.map((v: any) => `
          <div class="grid grid-cols-5 items-center px-4 py-4 rounded-[16px] bg-[#111214] border border-[#262629] hover:border-white/10 hover:bg-white/[0.02] transition-colors duration-200">

            <div class="flex items-center gap-4 min-w-0">
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#A78BFA] to-[#8B5CF6] flex items-center justify-center flex-shrink-0 shadow-lg shadow-[#A78BFA]/20">
                <span class="text-white text-[14px] font-bold">
                  ${v.nombre?.charAt(0)?.toUpperCase() || "?"}
                </span>
              </div>
              <div class="min-w-0">
                <p class="text-[14px] font-semibold text-white truncate">${v.nombre || ""}</p>
                <p class="text-[12px] font-medium text-[#9ca3af] truncate">@${v.usuario || ""}</p>
              </div>
            </div>

            <div class="min-w-0 pr-4">
              <p class="text-[14px] font-medium text-[#d1d5db] truncate">${v.juego || ""}</p>
              ${v.es_regalo ? `<p class="text-[11px] font-semibold text-[#A78BFA] mt-0.5 truncate flex items-center gap-1"><svg class="w-3.5 h-3.5 text-[#A78BFA] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5a2 2 0 10-2 2h2zm-2 4h4M5 11h14v10H5V11z"></path></svg> Para: ${v.dest_nombre || v.dest_usuario || ""} (${v.dest_correo || ""})</p>` : ""}
            </div>

            <div>
              <p class="text-[13px] font-medium text-[#9ca3af]">${v.fecha || ""}</p>
            </div>

            <div class="text-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white/[0.03] border border-white/10 text-[13px] font-bold text-white">
                ${v.cantidad || 1}
              </span>
            </div>

            <div class="text-right">
              <span class="text-[15px] font-bold text-[#10B981]">
                S/ ${((v.precio || 0) * (v.cantidad || 0)).toFixed(2)}
              </span>
            </div>

          </div>
        `).join("");

      } catch (e) {
        console.error(e);
        list.innerHTML = `<p class="text-zinc-500 text-sm px-4">Error al cargar datos</p>`;
      } finally {
        btnPrev.disabled = offset === 0;
        btnNext.disabled = !hasMore;
      }
    }

    btnPrev.addEventListener("click", () => {
      if (offset >= PAGE) { offset -= PAGE; loadPage(); }
    });

    btnNext.addEventListener("click", () => {
      if (hasMore) { offset += PAGE; loadPage(); }
    });

    loadPage();
  });
</script>