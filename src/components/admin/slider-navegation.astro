<div class="font-space w-64 h-screen bg-[#18181B] border-2 border-[#27272A] flex flex-col">
    <div class="flex gap-2 font-bold mt-8 pl-6 pr-6 items-center mb-10">
        <p class="text-2xl text-white">XDG</p>
        <p
            class="flex justify-center items-center text-[10px] text-[#3C0091] bg-[#D0BCFF] rounded-sm w-12 h-5"
            id="admin-role-badge"
        >
            ADMIN
        </p>
    </div>

    <nav aria-label="Menú principal" class="flex flex-col flex-1">
        <ul class="ml-2 text-sm">

            <!-- DASHBOARD — solo ADMIN -->
            <li class="mb-2 admin-only-item">
                <a
                    href="#"
                    data-section="dashboard"
                    class="admin-nav-link flex items-center w-59 h-11 pl-4 text-[#a78bfa] border-l-4 border-[#8B5CF6] bg-[#27272A]/50 hover:bg-[#27272A]/50 hover:text-[#a78bfa] transition-colors duration-200"
                    aria-current="page"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18">
                        <path d="M10 6V0h8v6zM0 10V0h8v10zm10 8V8h8v10zM0 18v-6h8v6zM2 8h4V2H2zm10 8h4v-6h-4zm0-12h4V2h-4zM2 16h4v-2H2z"/>
                    </svg>
                    <span class="ml-4">DASHBOARD</span>
                </a>
            </li>

            <!-- REGISTRO DE JUEGOS — ADMIN y SOPORTE -->
            <li class="mb-2">
                <a
                    href="#"
                    data-section="registro-juegos"
                    class="admin-nav-link flex items-center w-59 h-11 pl-4 text-[#71717a] hover:bg-[#27272A]/50 hover:text-[#a78bfa] transition-colors duration-200"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="14" fill="currentColor" viewBox="0 0 20 14"><path d="M2.535 14Q1.26 14 .56 13.113q-.7-.888-.525-2.163l1.05-7.5Q1.31 1.95 2.423.975A3.84 3.84 0 0 1 5.034 0h9.9q1.5 0 2.612.975t1.338 2.475l1.05 7.5q.176 1.274-.525 2.163-.7.887-1.975.887a2.5 2.5 0 0 1-.975-.187 2.6 2.6 0 0 1-.825-.563L13.385 11h-6.8l-2.25 2.25q-.375.375-.825.563a2.5 2.5 0 0 1-.975.187m.4-2.15L5.785 9h8.4l2.85 2.85q.05.05.4.15.275 0 .438-.162.162-.163.112-.438l-1.1-7.7a1.92 1.92 0 0 0-.65-1.213 1.9 1.9 0 0 0-1.3-.487h-9.9q-.75 0-1.3.487-.55.488-.65 1.213l-1.1 7.7q-.05.275.113.438a.6.6 0 0 0 .437.162q.05 0 .4-.15M14.985 8q.424 0 .713-.287A.97.97 0 0 0 15.985 7a.97.97 0 0 0-.287-.713.97.97 0 0 0-.713-.287.97.97 0 0 0-.712.287.97.97 0 0 0-.288.713q0 .424.288.713.287.287.712.287m-2-3q.424 0 .713-.287A.97.97 0 0 0 13.985 4a.97.97 0 0 0-.287-.712.97.97 0 0 0-.713-.288.97.97 0 0 0-.712.288.97.97 0 0 0-.288.712q0 .424.288.713.287.287.712.287m-7.25 3h1.5V6.25h1.75v-1.5h-1.75V3h-1.5v1.75h-1.75v1.5h1.75z"/></svg>
                    <span class="ml-4">REGISTRO DE JUEGOS</span>
                </a>
            </li>

            <!-- HISTORIAL DE VENTAS — solo ADMIN -->
            <li class="admin-only-item">
                <a
                    href="#"
                    data-section="registro-ventas"
                    class="admin-nav-link flex items-center w-59 h-11 pl-4 text-[#71717a] hover:bg-[#27272A]/50 hover:text-[#a78bfa] transition-colors duration-200"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18"><path d="M4 14h2V9H4zm8 0h2V4h-2zm-4 0h2v-3H8zm0-5h2V7H8zm-6 9q-.824 0-1.412-.587A1.93 1.93 0 0 1 0 16V2Q0 1.176.588.588A1.93 1.93 0 0 1 2 0h14q.824 0 1.413.588Q18 1.175 18 2v14q0 .824-.587 1.413A1.93 1.93 0 0 1 16 18zm0-2h14V2H2zM2 2v14z"/></svg>
                    <span class="ml-4">HISTORIAL DE VENTAS</span>
                </a>
            </li>

            <!-- GESTIÓN DE ADMINISTRADORES — solo ADMIN -->
            <li class="admin-only-item">
                <a
                    href="#"
                    data-section="registro-admin"
                    class="admin-nav-link flex items-center w-59 h-11 pl-4 text-[#71717a] hover:bg-[#27272A]/50 hover:text-[#a78bfa] transition-colors duration-200"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18"><path d="M4 14h2V9H4zm8 0h2V4h-2zm-4 0h2v-3H8zm0-5h2V7H8zm-6 9q-.824 0-1.412-.587A1.93 1.93 0 0 1 0 16V2Q0 1.176.588.588A1.93 1.93 0 0 1 2 0h14q.824 0 1.413.588Q18 1.175 18 2v14q0 .824-.587 1.413A1.93 1.93 0 0 1 16 18zm0-2h14V2H2zM2 2v14z"/></svg>
                    <span class="ml-4">GESTION DE ADMINISTRADORES</span>
                </a>
            </li>

            <!-- GESTIÓN DE CATEGORÍAS — solo ADMIN -->
            <li class="admin-only-item">
                <a
                    href="#"
                    data-section="categorias"
                    class="admin-nav-link flex items-center w-59 h-11 pl-4 text-[#71717a] hover:bg-[#27272A]/50 hover:text-[#a78bfa] transition-colors duration-200"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18"><path d="M4 14h2V9H4zm8 0h2V4h-2zm-4 0h2v-3H8zm0-5h2V7H8zm-6 9q-.824 0-1.412-.587A1.93 1.93 0 0 1 0 16V2Q0 1.176.588.588A1.93 1.93 0 0 1 2 0h14q.824 0 1.413.588Q18 1.175 18 2v14q0 .824-.587 1.413A1.93 1.93 0 0 1 16 18zm0-2h14V2H2zM2 2v14z"/></svg>
                    <span class="ml-4">GESTION DE CATEGORIAS</span>
                </a>
            </li>

        </ul>

        <button
            id="logoutBtn"
            class="mt-auto ml-2 mb-6 flex items-center w-59 h-11 pl-4 text-[#71717a] hover:bg-[#27272A]/50 rounded-sm transition-colors duration-200 hover:text-white"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 18 18">
                <path d="M2 18q-.824 0-1.412-.587A1.93 1.93 0 0 1 0 16V2Q0 1.176.588.588A1.93 1.93 0 0 1 2 0h7v2H2v14h7v2zm11-4-1.375-1.45 2.55-2.55H6V8h8.175l-2.55-2.55L13 4l5 5z"/>
            </svg>
            <span class="ml-4">CERRAR SESION</span>
        </button>
    </nav>

    <script>
        const API = "http://localhost:8080";

        document.addEventListener("DOMContentLoaded", () => {
            const links          = document.querySelectorAll<HTMLElement>(".admin-nav-link");
            const content        = document.getElementById("admin-main-content");
            const sectionEls     = content ? content.querySelectorAll<HTMLElement>("[data-admin-section]") : [];
            const adminOnlyItems = document.querySelectorAll<HTMLElement>(".admin-only-item");
            const badge          = document.getElementById("admin-role-badge");

            // ── helpers locales ──────────────────────────────────────────
            function renderSection(section: string) {
                sectionEls.forEach(s => s.classList.add("hidden"));
                content?.querySelector<HTMLElement>(`[data-admin-section="${section}"]`)
                    ?.classList.remove("hidden");
            }

            function activateLink(link: HTMLElement) {
                links.forEach(l => {
                    l.classList.remove("text-[#a78bfa]", "border-l-4", "border-[#8B5CF6]", "bg-[#27272A]/50");
                    l.classList.add("text-[#71717a]");
                    l.removeAttribute("aria-current");
                });
                link.classList.remove("text-[#71717a]");
                link.classList.add("text-[#a78bfa]", "border-l-4", "border-[#8B5CF6]", "bg-[#27272A]/50");
                link.setAttribute("aria-current", "page");
            }

            // ── clicks de navegación ─────────────────────────────────────
            links.forEach(link => {
                link.addEventListener("click", e => {
                    e.preventDefault();
                    activateLink(link);
                    renderSection(link.dataset.section ?? "");
                });
            });

            // ── evento global open-admin-section ────────────────────────
            window.addEventListener("open-admin-section", (e: Event) => {
                const detail  = (e as CustomEvent).detail;
                const section = detail?.section as string | undefined;
                if (!section) return;
                const target = Array.from(links).find(l => l.dataset.section === section);
                if (target) {
                    activateLink(target);
                    renderSection(section);
                }
            });

            // ── aplicar restricciones según sub_role ─────────────────────
            async function applyRoleRestrictions() {
                try {
                    const res  = await fetch(`${API}/api/session.jsp`, { credentials: "include" });
                    const data = await res.json();

                    const isSoporte = data.sub_role === "SOPORTE";

                    if (isSoporte) {
                        // Actualizar badge
                        if (badge) {
                            badge.textContent    = "SOPORTE";
                            badge.style.background = "#22c55e20";
                            badge.style.color      = "#22c55e";
                        }
                        // Ocultar ítems exclusivos de ADMIN
                        adminOnlyItems.forEach(el => { el.style.display = "none"; });
                        // Sección inicial para SOPORTE
                        renderSection("registro-juegos");
                        const link = Array.from(links).find(l => l.dataset.section === "registro-juegos");
                        if (link) activateLink(link);

                    } else {
                        // ADMIN: todo visible
                        if (badge) badge.textContent = "ADMIN";
                        renderSection("dashboard");
                        const link = Array.from(links).find(l => l.dataset.section === "dashboard");
                        if (link) activateLink(link);
                    }

                } catch (e) {
                    console.error("Error al verificar rol:", e);
                }
            }

            applyRoleRestrictions();

            // ── logout ───────────────────────────────────────────────────
            document.getElementById("logoutBtn")?.addEventListener("click", async () => {
                try {
                    await fetch(`${API}/api/auth.jsp?action=logout`, {
                        method: "POST",
                        credentials: "include",
                    });
                } catch (err) {
                    console.error("Error al cerrar sesión:", err);
                } finally {
                    window.location.href = "/user";
                }
            });
        });
    </script>
</div>