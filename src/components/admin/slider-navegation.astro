    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const links = document.querySelectorAll(".admin-nav-link");
            const content = document.getElementById("admin-main-content");
            const sectionElements = content ? content.querySelectorAll("[data-admin-section]") : [];

            const renderSection = (section:string) => {
                if (!content) return;

                sectionElements.forEach((sectionEl) => {
                    sectionEl.classList.add("hidden");
                });

                const target = content.querySelector(`[data-admin-section="${section}"]`);
                if (target) {
                    target.classList.remove("hidden");
                }
            };

            const activate = (link:any) => {
                links.forEach((l) => {
                    l.classList.remove(
                        "text-[#a78bfa]",
                        "border-l-4",
                        "border-[#8B5CF6]",
                        "bg-[#27272A]/50"
                    );

                    l.classList.add("text-[#71717a]");
                    l.removeAttribute("aria-current");
                });

                link.classList.remove("text-[#71717a]");

                link.classList.add(
                    "text-[#a78bfa]",
                    "border-l-4",
                    "border-[#8B5CF6]",
                    "bg-[#27272A]/50"
                );

                link.setAttribute("aria-current", "page");
                renderSection(link.dataset.section);
                window.dispatchEvent(new CustomEvent("section-opened", { detail: { section: link.dataset.section } }));
            };

            links.forEach((link) => {
                link.addEventListener("click", (e) => {
                    e.preventDefault();
                    activate(link);
                });
            });

            window.addEventListener("open-admin-section", (e: any) => {
                const section = e.detail?.section;
                if (!section) return;
                const targetLink = Array.from(links).find(
                    (l: any) => l.dataset.section === section
                );
                if (targetLink) {
                    activate(targetLink);
                }
            });

            renderSection("dashboard");
            
            fetch("http://localhost:8080/api/session.jsp", { credentials: "include" })
                .then(res => res.json())
                .then(data => {
                    if (data.logged) {
                        const actualRole = data.sub_role || data.role || "ADMIN";
                        const roleBadge = document.getElementById("roleBadge");
                        if (roleBadge) {
                            roleBadge.textContent = actualRole.toUpperCase();
                        }

                        if (actualRole.toUpperCase() === "SOPORTE") {
                            const ventasLink = document.querySelector('[data-section="registro-ventas"]');
                            if (ventasLink && ventasLink.parentElement) {
                                ventasLink.parentElement.style.display = 'none';
                            }
                            const reportesLink = document.querySelector('[data-section="reportes"]');
                            if (reportesLink && reportesLink.parentElement) {
                                reportesLink.parentElement.style.display = 'none';
                            }
                            const adminLink = document.querySelector('[data-section="registro-admin"]');
                            if (adminLink && adminLink.parentElement) {
                                adminLink.parentElement.style.display = 'none';
                            }
                        }
                    }
                })
                .catch(err => console.error("Error cargando sesión en slider:", err));
        });
        const logoutBtn = document.getElementById("logoutBtn");
if (logoutBtn) {
    logoutBtn.addEventListener("click", async () => {
        try {
            await fetch("http://localhost:8080/api/auth.jsp?action=logout", {
                method: "POST",
                credentials: "include",
            });
        } catch (e) {
            console.error("Error al cerrar sesión:", e);
        } finally {
            window.location.href = "/user";
        }
    });
}
    </script>
