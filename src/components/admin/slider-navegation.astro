        viewBox="0 0 18 18"
    >
        <path
            d="M2 18q-.824 0-1.412-.587A1.93 1.93 0 0 1 0 16V2Q0 1.176.588.588A1.93 1.93 0 0 1 2 0h7v2H2v14h7v2zm11-4-1.375-1.45 2.55-2.55H6V8h8.175l-2.55-2.55L13 4l5 5z"
        />
    </svg>
    <span class="ml-4">CERRAR SESION</span>
</button>
