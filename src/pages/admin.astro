---
import SliderNavegation from "../components/admin/slider-navegation.astro";
import Search from "../components/admin/search.astro";
import DashboardSection from "../components/admin/sections/dashboard/DashboardSection.astro";
import RegistroJuegosSection from "../components/admin/sections/register-game/RegistroJuegosSection.astro";
import RegistroVentasSection from "../components/admin/sections/sales-history/RegistroVentasSection.astro";
import RegistroAdminSection from "../components/admin/sections/register-admi/RegistroAdmiSection.astro";
import ReportesSection from "../components/admin/sections/ReportesSection.astro";
import CategoriasSection from "../components/admin/sections/gest-category/CategoryPanel.astro";
import UserSection from "../components/admin/sections/gest-user/UserPanel.astro";
import AuditoriaSection from "../components/admin/sections/AuditoriaSection.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Document</title>
    </head>
 <body class="font-space bg-[#15121B]">
            <div class="flex h-screen overflow-hidden">
            <SliderNavegation />

            <div class="flex-1 flex flex-col overflow-hidden">
                <Search />

                <div
                    id="admin-main-content"
                    class="flex-1 overflow-y-auto bg-[#15121B] p-2"
                >
                    <div data-admin-section="dashboard">
                        <DashboardSection />
                    </div>

                    <div data-admin-section="registro-juegos" class="hidden">
                        <RegistroJuegosSection />
                    </div>

                    <div data-admin-section="registro-ventas" class="hidden">
                        <RegistroVentasSection />
                    </div>

                    <div data-admin-section="registro-admin" class="hidden">
                        <RegistroAdminSection />
                    </div>

                    <div data-admin-section="reportes" class="hidden">
                        <ReportesSection />
                    </div>

                    <div data-admin-section="categorias" class="hidden">
                        <CategoriasSection />
                    </div>

                    <div data-admin-section="usuarios" class="hidden">
                        <UserSection />
                    </div>

                    <div data-admin-section="auditoria" class="hidden">
                        <AuditoriaSection />
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
